@page
@model ProductosModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inventario - Ferretería</title>
    <partial name="_Estilos" />
    <style>
        .productos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1.5rem;
            padding: 1rem 0;
        }
        .producto-card {
            background: var(--fer-superficie);
            border: 1px solid var(--fer-borde);
            border-radius: var(--fer-radio);
            overflow: hidden;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .producto-card:hover {
            box-shadow: var(--fer-sombra-hover);
            transform: translateY(-2px);
        }
        .producto-imagen {
            width: 100%;
            aspect-ratio: 1;
            background: var(--fer-superficie-2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: var(--fer-texto-suave);
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        .producto-imagen img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .producto-imagen-vacia {
            font-size: 2.5rem;
            opacity: 0.5;
        }
        .producto-info {
            padding: 1rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .producto-nombre {
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--fer-texto);
            margin-bottom: 0.3rem;
            line-height: 1.3;
        }
        .producto-codigo {
            font-size: 0.85rem;
            color: var(--fer-texto-suave);
            margin-bottom: 0.5rem;
        }
        .producto-barras { font-size: 0.78rem; letter-spacing: 0.04em; opacity: 0.85; }
        .producto-categorias {
            display: flex;
            flex-wrap: wrap;
            gap: 0.25rem;
            margin-bottom: 0.75rem;
        }
        .cat-badge {
            display: inline-block;
            background: rgba(255, 237, 0, 0.15);
            color: var(--fer-naranja);
            font-size: 0.7rem;
            padding: 0.25rem 0.5rem;
            border-radius: 3px;
            font-weight: 500;
        }
        .producto-precios {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
            font-size: 0.85rem;
        }
        .precio-item {
            display: flex;
            flex-direction: column;
        }
        .precio-label {
            color: var(--fer-texto-suave);
            font-size: 0.75rem;
        }
        .precio-valor {
            font-weight: 600;
            color: var(--fer-naranja);
        }
        .producto-stock {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            margin-bottom: 1rem;
            padding: 0.5rem;
            background: var(--fer-superficie-2);
            border-radius: 4px;
            font-size: 0.85rem;
        }
        .stock-valor {
            font-weight: 600;
        }
        .stock-minimo {
            color: var(--fer-texto-suave);
            font-size: 0.75rem;
        }
        .stock-fila {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        /* Barra de stock: rojo agotado o bajo, amarillo cerca del mínimo, verde bien */
        .stock-barra {
            position: relative;
            display: block;
            height: 6px;
            border-radius: 3px;
            background: #333;
        }
        .stock-barra span {
            display: block;
            height: 100%;
            border-radius: 3px;
            background: var(--fer-verde);
            transition: width 0.3s ease;
        }
        .stock-marca-minimo {
            position: absolute;
            left: 33.3%;
            top: -3px;
            bottom: -3px;
            width: 2px;
            background: var(--fer-texto-suave);
            opacity: 0.6;
        }
        .stock-medio .stock-barra span { background: var(--fer-naranja); }
        .stock-bajo .stock-barra span,
        .stock-agotado .stock-barra span { background: var(--fer-rojo); }
        .stock-bajo .stock-valor,
        .stock-agotado .stock-valor { color: var(--fer-rojo); }

        /* Buscador con lupa y aviso de "buscando" */
        .busqueda-caja { position: relative; }
        .busqueda-caja .busqueda-input { padding-left: 2.6rem; font-size: 1.05rem; }
        .busqueda-icono {
            position: absolute;
            left: 0.95rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--fer-texto-suave);
        }
        .busqueda-girando {
            position: absolute;
            right: 0.9rem;
            top: 50%;
            width: 1.1rem;
            height: 1.1rem;
            margin-top: -0.55rem;
            border: 2px solid var(--fer-naranja);
            border-right-color: transparent;
            border-radius: 50%;
            opacity: 0;
            animation: fer-girar 0.7s linear infinite;
            transition: opacity 0.15s ease;
        }
        .busqueda-caja.buscando .busqueda-girando { opacity: 1; }
        @@keyframes fer-girar { to { transform: rotate(360deg); } }

        /* Botones Tarjetas / Lista */
        .vista-selector {
            display: inline-flex;
            border: 1px solid var(--fer-borde);
            border-radius: var(--fer-radio-sm);
            overflow: hidden;
        }
        .vista-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            min-height: 40px;
            padding: 0 0.9rem;
            border: 0;
            background: var(--fer-superficie);
            color: var(--fer-texto-suave);
            font-weight: 600;
        }
        .vista-btn[aria-pressed="true"] {
            background: var(--fer-naranja);
            color: #000;
        }

        /* Vista en lista: una fila por producto, foto pequeña y lo esencial */
        .vista-lista .productos-grid {
            grid-template-columns: 1fr;
            gap: 0.5rem;
            padding-top: 0.5rem;
        }
        .vista-lista .producto-card {
            flex-direction: row;
            align-items: stretch;
        }
        .vista-lista .producto-card:hover { transform: none; }
        .vista-lista .producto-imagen {
            width: 76px;
            flex-shrink: 0;
            aspect-ratio: 1;
            height: 76px;
            align-self: center;
            margin-left: 0.5rem;
            border-radius: var(--fer-radio-sm);
        }
        .vista-lista .producto-imagen::after { display: none; }
        .vista-lista .producto-info {
            flex-direction: row;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.4rem 1.25rem;
            padding: 0.6rem 0.9rem;
            flex: 1 1 auto;
            min-width: 0;
        }
        .vista-lista .producto-nombre { flex: 1 1 100%; margin: 0; font-size: 1rem; }
        .vista-lista .producto-codigo { flex: 1 1 160px; margin: 0; }
        .vista-lista .producto-categorias { display: none; }
        .vista-lista .producto-precios { display: block; margin: 0; min-width: 110px; }
        .vista-lista .producto-precios .precio-item + .precio-item { display: none; }
        .vista-lista .producto-stock { margin: 0; width: 180px; }
        .vista-lista .producto-acciones { flex-wrap: nowrap; margin-left: auto; }
        .vista-lista .producto-card .btn-accion { flex: 0 0 auto; width: auto; padding: 0.4rem 0.8rem; }
        .vista-lista .producto-card .producto-acciones > .btn-movimientos { flex: 0 0 auto; }
        .vista-lista .producto-acciones form { flex: 0 0 auto !important; }
        @@media (max-width: 767.98px) {
            .vista-lista .producto-imagen { width: 60px; height: 60px; align-self: flex-start; margin-top: 0.6rem; }
            .vista-lista .producto-stock { width: 100%; }
            .vista-lista .producto-info { padding: 0.6rem 0.7rem; gap: 0.4rem 0.75rem; }
            .vista-lista .producto-acciones { margin-left: 0; width: 100%; flex-wrap: wrap; gap: 0.4rem; }
            .vista-lista .producto-card .btn-accion,
            .vista-lista .producto-card .producto-acciones > .btn-movimientos,
            .vista-lista .producto-acciones form { flex: 1 1 auto !important; }
            .vista-lista .producto-card .btn-accion { padding: 0.4rem 0.5rem; font-size: 0.85rem; }
            .vista-lista .producto-acciones form .btn-accion { width: 100%; }
        }

        .badge-bajo {
            background: var(--fer-rojo);
            color: white;
            font-size: 0.7rem;
            padding: 0.25rem 0.5rem;
            border-radius: 3px;
            font-weight: 600;
        }
        .producto-acciones {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        .btn-accion {
            flex: 1;
            min-width: 60px;
            font-size: 0.8rem;
            padding: 0.4rem 0.5rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-movimientos {
            background: var(--fer-superficie-2);
            color: var(--fer-texto);
        }
        .btn-movimientos:hover {
            background: var(--fer-borde);
        }
        .btn-editar {
            background: var(--fer-naranja);
            color: var(--fer-negro);
            font-weight: 600;
        }
        .btn-editar:hover {
            opacity: 0.9;
        }
        .btn-eliminar {
            background: var(--fer-rojo);
            color: white;
        }
        .btn-eliminar:hover {
            opacity: 0.9;
        }
        .filtros-contenedor {
            background: var(--fer-superficie);
            border: 1px solid var(--fer-borde);
            border-radius: var(--fer-radio);
            padding: 1.25rem;
            margin-bottom: 2rem;
        }
        .busqueda-input {
            background: var(--fer-superficie-2);
            border: 1px solid var(--fer-borde);
            color: var(--fer-texto);
            padding: 0.75rem 1rem;
            border-radius: 4px;
            width: 100%;
        }
        .busqueda-input::placeholder {
            color: var(--fer-texto-suave);
        }
        .busqueda-input:focus {
            outline: none;
            border-color: var(--fer-naranja);
            box-shadow: 0 0 0 3px rgba(255, 237, 0, 0.1);
        }
        .chips-contenedor {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 1rem;
        }
        .chip {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.75rem;
            background: var(--fer-superficie-2);
            border: 1px solid var(--fer-borde);
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.9rem;
            text-decoration: none;
            color: var(--fer-texto);
        }
        .chip:hover {
            border-color: var(--fer-naranja);
            background: rgba(255, 237, 0, 0.1);
        }
        .chip.activo {
            background: var(--fer-naranja);
            color: var(--fer-negro);
            border-color: var(--fer-naranja);
            font-weight: 600;
        }
        .chip-imagen {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--fer-superficie);
            overflow: hidden;
            flex-shrink: 0;
        }
        .chip-imagen img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .chip-cantidad {
            background: rgba(0, 0, 0, 0.2);
            padding: 0 0.35rem;
            border-radius: 3px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .resumen {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            color: var(--fer-texto-suave);
        }
        .resumen-item {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }
        .btn-limpiar {
            background: var(--fer-rojo);
            color: white;
            border: none;
            padding: 0.4rem 0.8rem;
            border-radius: 4px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-limpiar:hover {
            opacity: 0.9;
        }
        .paginacion {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }
        .pag-btn {
            background: var(--fer-superficie-2);
            border: 1px solid var(--fer-borde);
            color: var(--fer-texto);
            padding: 0.5rem 0.75rem;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            font-size: 0.9rem;
        }
        .pag-btn:hover {
            border-color: var(--fer-naranja);
            background: rgba(255, 237, 0, 0.1);
        }
        .pag-btn.activa {
            background: var(--fer-naranja);
            color: var(--fer-negro);
            font-weight: 600;
            border-color: var(--fer-naranja);
        }
        .pag-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .vacio {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--fer-texto-suave);
        }
        .vacio i {
            font-size: 3rem;
            opacity: 0.3;
            margin-bottom: 1rem;
        }
        .modal-lightbox {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.85);
            z-index: 1050;
            align-items: center;
            justify-content: center;
        }
        .modal-lightbox.activo {
            display: flex;
        }
        .modal-lightbox-content {
            position: relative;
            max-width: 90vw;
            max-height: 90vh;
        }
        .modal-lightbox img {
            max-width: 100%;
            max-height: 100%;
            border-radius: 8px;
        }
        .modal-lightbox-close {
            position: absolute;
            top: -40px;
            right: 0;
            background: none;
            border: none;
            color: white;
            font-size: 2rem;
            cursor: pointer;
        }
        .modal-lightbox-close:hover {
            opacity: 0.7;
        }
    </style>
</head>
<body>

<partial name="_Barra" />

<main class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Inventario</h1>
        @if (User.IsInRole("admin"))
        {
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-fer-outline" href="/Reposicion"><i class="bi bi-cart-plus"></i> Qué comprar</a>
                <a class="btn btn-fer-outline" href="/Etiquetas"><i class="bi bi-upc-scan"></i> Etiquetas</a>
                <a class="btn btn-fer" href="/Nuevo">
                    <i class="bi bi-plus-circle"></i> Nuevo producto
                </a>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="@(Model.EsError ? "alert" : "status")">
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="filtros-contenedor">
        @* Búsqueda instantánea: los resultados cambian mientras se escribe, sin recargar la página.
           Los campos ocultos conservan la categoría y los filtros elegidos. *@
        <form role="search" class="mb-0 busqueda-caja" id="form-busqueda" action="/Productos" method="get">
            <i class="bi bi-search busqueda-icono" aria-hidden="true"></i>
            <input type="search" class="busqueda-input" name="q" value="@Model.Q" autocomplete="off"
                   placeholder="Buscar por código, nombre, medida o lector de barras..." aria-label="Buscar productos" />
            <span class="busqueda-girando" aria-hidden="true"></span>
            @if (Model.Categoria is not null) { <input type="hidden" name="categoria" value="@Model.Categoria" /> }
            @if (Model.Sub is not null) { <input type="hidden" name="sub" value="@Model.Sub" /> }
            @if (Model.Bajo) { <input type="hidden" name="bajo" value="true" /> }
        </form>

        <div id="filtros-chips">
        <div class="chips-contenedor">
            <a href="@Model.Enlace(null, null, false, 1)" class="chip @(Model.Categoria is null ? "activo" : "")">
                <i class="bi bi-collection"></i>
                Todas <span class="chip-cantidad">@Model.TotalGeneral</span>
            </a>

            @foreach (var cat in Model.Categorias)
            {
                <a href="@Model.Enlace(cat.Id, null, false, 1)" class="chip @(Model.Categoria == cat.Id ? "activo" : "")" data-categoria="@cat.Id">
                    @if (cat.Imagen is not null)
                    {
                        <div class="chip-imagen">
                            <img src="@Model.ObtenerRutaImagen(cat.Imagen, "categorias")" alt="@cat.Nombre" />
                        </div>
                    }
                    @cat.Nombre
                    <span class="chip-cantidad">@cat.Cantidad</span>
                </a>
            }
        </div>

        @if (Model.Categoria is not null && Model.Subcategorias.Count > 0)
        {
            <div class="chips-contenedor mt-2">
                <a href="@Model.Enlace(Model.Categoria, null, false, 1)" class="chip @(Model.Sub is null ? "activo" : "")">
                    <i class="bi bi-funnel"></i>
                    Todas <span class="chip-cantidad">@Model.Subcategorias.Sum(s => s.Cantidad)</span>
                </a>
                @foreach (var sub in Model.Subcategorias)
                {
                    <a href="@Model.Enlace(Model.Categoria, sub.Id, false, 1)" class="chip @(Model.Sub == sub.Id ? "activo" : "")">
                        @sub.Nombre
                        <span class="chip-cantidad">@sub.Cantidad</span>
                    </a>
                }
            </div>
        }

        <div class="chips-contenedor mt-2">
            <a href="@Model.Enlace(Model.Categoria, Model.Sub, !Model.Bajo, 1)" class="chip @(Model.Bajo ? "activo" : "")">
                <i class="bi bi-exclamation-circle"></i>
                Stock bajo <span class="chip-cantidad">@Model.TotalBajo</span>
            </a>

            @if (Model.HayFiltros)
            {
                <a href="/Productos" class="btn btn-limpiar">
                    <i class="bi bi-x-circle"></i> Limpiar filtros
                </a>
            }
        </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-2">
        <div class="vista-selector" role="group" aria-label="Forma de ver los productos">
            <button type="button" class="vista-btn" data-vista="tarjetas" aria-pressed="true">
                <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>Tarjetas
            </button>
            <button type="button" class="vista-btn" data-vista="lista" aria-pressed="false">
                <i class="bi bi-list-ul" aria-hidden="true"></i>Lista
            </button>
        </div>
    </div>

    <div id="resultados" aria-live="polite">

    @if (Model.HayFiltros)
    {
        <div class="resumen">
            <span class="resumen-item">
                <i class="bi bi-funnel"></i>
                Mostrando <strong>@Model.TotalFiltrado</strong> de <strong>@Model.TotalGeneral</strong> productos
            </span>
            @if (Model.Pagina > 1)
            {
                <span class="resumen-item">
                    Página <strong>@Model.Pagina</strong> de <strong>@Model.TotalPaginas</strong>
                </span>
            }
        </div>
    }

    @if (Model.Lista.Count == 0)
    {
        <div class="fer-card fer-vacio">
            <i class="bi bi-inbox" aria-hidden="true"></i>
            <h2>No hay productos</h2>
            <p class="mb-3">@(Model.HayFiltros ? "Ningún producto coincide con la búsqueda. Intenta cambiar los filtros." : "Comienza creando el primer producto.")</p>
            @if (Model.HayFiltros)
            {
                <a class="btn btn-fer-outline" href="/Productos"><i class="bi bi-x-circle me-2" aria-hidden="true"></i>Quitar filtros</a>
            }
        </div>
    }
    else
    {
        <div class="productos-grid">
            @foreach (var producto in Model.Lista)
            {
                var tieneFoto = !string.IsNullOrEmpty(producto.Imagen);
                <div class="producto-card">
                    <div class="producto-imagen @(tieneFoto ? "" : "sin-foto")" onclick="abrirLightbox('@(tieneFoto ? Model.ObtenerRutaImagen(producto.Imagen, "productos") : "")')">
                        @if (tieneFoto)
                        {
                            <img src="@Model.ObtenerRutaImagen(producto.Imagen, "productos")" alt="@producto.Nombre" />
                        }
                        else
                        {
                            <img class="fer-sin-foto" src="@Ferreteria.Services.DibujoSinFoto.Ruta(producto.Nombre, producto.Categorias)" alt="Sin foto" />
                        }
                    </div>

                    <div class="producto-info">
                        <div class="producto-nombre">@producto.Nombre</div>
                        <div class="producto-codigo">
                            @producto.Codigo
                            @if (!string.IsNullOrEmpty(producto.Medida))
                            {
                                <span> · @producto.Medida</span>
                            }
                            @if (!string.IsNullOrEmpty(producto.CodigoBarras))
                            {
                                <span class="producto-barras d-block"><i class="bi bi-upc" aria-hidden="true"></i> @producto.CodigoBarras</span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(producto.Categorias))
                        {
                            <div class="producto-categorias">
                                @foreach (var cat in producto.Categorias.Split(',').Select(c => c.Trim()))
                                {
                                    <span class="cat-badge">@cat</span>
                                }
                            </div>
                        }

                        <div class="producto-precios">
                            <div class="precio-item">
                                <span class="precio-label">Venta</span>
                                <span class="precio-valor">@producto.PrecioVenta.ToString("C0")</span>
                            </div>
                            <div class="precio-item">
                                <span class="precio-label">Compra</span>
                                <span class="precio-valor">@producto.PrecioCompra.ToString("C0")</span>
                            </div>
                        </div>

                        <div class="producto-stock stock-@producto.NivelStock">
                            <div class="stock-fila">
                                <div>
                                    <span class="stock-valor">@producto.Stock</span>
                                    <span class="stock-minimo">@(producto.StockMinimo > 0 ? $"/ mín: {producto.StockMinimo}" : "en stock")</span>
                                </div>
                                @if (producto.NivelStock == "agotado")
                                {
                                    <span class="badge-bajo">AGOTADO</span>
                                }
                                else if (producto.StockBajo)
                                {
                                    <span class="badge-bajo">BAJO</span>
                                }
                            </div>
                            <div class="stock-barra" role="img"
                                 aria-label="Stock @producto.Stock@(producto.StockMinimo > 0 ? $" de mínimo {producto.StockMinimo}" : "")">
                                <span style="width:@(producto.PorcentajeStock)%"></span>
                                @if (producto.StockMinimo > 0)
                                {
                                    @* Rayita que marca dónde está el mínimo (un tercio de la barra) *@
                                    <i class="stock-marca-minimo" aria-hidden="true"></i>
                                }
                            </div>
                        </div>

                        <div class="producto-acciones">
                            @if (User.IsInRole("admin"))
                            {
                                <a href="/Movimientos/@producto.Id" class="btn-accion btn-movimientos">
                                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>Movimientos
                                </a>
                                <a href="/Editar/@producto.Id" class="btn-accion btn-editar">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>Editar
                                </a>
                                <form method="post" action="/Productos?handler=Eliminar" style="flex: 1;">
                                    <input type="hidden" name="id" value="@producto.Id" />
                                    <input type="hidden" name="retorno" value="@Model.EnlaceActual()" />
                                    <button type="submit" class="btn-accion btn-eliminar"
                                            data-confirmar="¿Eliminar &quot;@producto.Nombre&quot;? Ya no aparecerá en el inventario."
                                            data-confirmar-boton="Sí, eliminar" data-confirmar-tipo="peligro">
                                        <i class="bi bi-trash" aria-hidden="true"></i>Eliminar
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="paginacion">
                @if (Model.Pagina > 1)
                {
                    <a href="@Model.Enlace(Model.Categoria, Model.Sub, Model.Bajo, Model.Pagina - 1)" class="pag-btn">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </a>
                }

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    @if (i == Model.Pagina)
                    {
                        <button class="pag-btn activa" disabled>@i</button>
                    }
                    else if (i <= Model.Pagina + 2 && i >= Model.Pagina - 2)
                    {
                        <a href="@Model.Enlace(Model.Categoria, Model.Sub, Model.Bajo, i)" class="pag-btn">@i</a>
                    }
                }

                @if (Model.Pagina < Model.TotalPaginas)
                {
                    <a href="@Model.Enlace(Model.Categoria, Model.Sub, Model.Bajo, Model.Pagina + 1)" class="pag-btn">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
    </div>

</main>

<div id="lightbox" class="modal-lightbox">
    <div class="modal-lightbox-content">
        <button class="modal-lightbox-close" onclick="cerrarLightbox()">✕</button>
        <img id="lightbox-imagen" src="" alt="Imagen ampliada" />
    </div>
</div>

<script>
function abrirLightbox(src) {
    if (!src) return;
    const lightbox = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-imagen');
    img.src = src;
    lightbox.classList.add('activo');
}

function cerrarLightbox() {
    document.getElementById('lightbox').classList.remove('activo');
}

document.getElementById('lightbox').addEventListener('click', (e) => {
    if (e.target.id === 'lightbox') cerrarLightbox();
});

// ---------- Búsqueda instantánea ----------
// Mientras se escribe, se piden los resultados al servidor y solo se cambia la lista,
// así el cursor no se pierde. Si algo falla, se abre la página normal con la búsqueda.
const formBusqueda = document.getElementById('form-busqueda');
const busqueda = formBusqueda.querySelector('.busqueda-input');
let esperaBusqueda, pedidoEnCurso;

function urlBusqueda() {
    const datos = new URLSearchParams(new FormData(formBusqueda));
    if (!datos.get('q').trim()) datos.delete('q');
    const texto = datos.toString();
    return '/Productos' + (texto ? '?' + texto : '');
}

function buscarAhora() {
    const url = urlBusqueda();
    if (pedidoEnCurso) pedidoEnCurso.abort();
    pedidoEnCurso = new AbortController();
    formBusqueda.classList.add('buscando');

    fetch(url, { signal: pedidoEnCurso.signal })
        .then(r => { if (!r.ok || r.redirected) throw new Error('respuesta'); return r.text(); })
        .then(html => {
            const nuevo = new DOMParser().parseFromString(html, 'text/html');
            for (const id of ['resultados', 'filtros-chips']) {
                const viejo = document.getElementById(id), reemplazo = nuevo.getElementById(id);
                if (viejo && reemplazo) viejo.replaceWith(reemplazo);
            }
            history.replaceState(null, '', url);
            formBusqueda.classList.remove('buscando');
        })
        .catch(err => { if (err.name !== 'AbortError') location.href = url; });
}

busqueda.addEventListener('input', () => {
    clearTimeout(esperaBusqueda);
    esperaBusqueda = setTimeout(buscarAhora, 250);
});

formBusqueda.addEventListener('submit', (e) => {
    e.preventDefault();
    clearTimeout(esperaBusqueda);
    buscarAhora();
});

// ---------- Vista en tarjetas o en lista compacta (se recuerda en este equipo) ----------
const botonesVista = document.querySelectorAll('.vista-btn');
function ponerVista(vista) {
    document.body.classList.toggle('vista-lista', vista === 'lista');
    botonesVista.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.vista === vista)));
}
botonesVista.forEach(b => b.addEventListener('click', () => {
    ponerVista(b.dataset.vista);
    try { localStorage.setItem('inventario-vista', b.dataset.vista); } catch (e) { }
}));
try { ponerVista(localStorage.getItem('inventario-vista') || 'tarjetas'); } catch (e) { }

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarLightbox();
});
</script>

</body>
</html>