@page
@model Ferreteria.Pages.ProductosModel
@{
    ViewData["Title"] = "Inventario";
}

<style>
    .tabla-inventario th,
    .tabla-inventario td {
        padding: 0.9rem 0.8rem;
        font-size: 1.05rem;
        vertical-align: middle;
    }

    .tabla-inventario thead th {
        font-size: 1rem;
    }

    .fila-alerta td {
        background-color: #f8d7da !important;
        color: #842029;
        font-weight: 600;
    }

    .buscador {
        position: relative;
        max-width: 640px;
    }

    .sugerencias {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1000;
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: 0 0 0.375rem 0.375rem;
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: 420px;
        overflow-y: auto;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    }

    .sugerencias li a {
        display: block;
        padding: 0.75rem 1rem;
        text-decoration: none;
        color: inherit;
        border-bottom: 1px solid #eee;
    }

    .sugerencias li a:hover {
        background: #e9f2ff;
    }

    .sugerencias .detalle {
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>

<h1>Inventario de tornillería</h1>

@if (User.Identity?.IsAuthenticated == true)
{
    <form method="post" asp-page="/Salir" class="mb-3">
        <span class="me-2">Sesión: @User.Identity.Name</span>
        <button type="submit" class="btn btn-sm btn-outline-secondary">Salir</button>
    </form>
}

@if (Model.Mensaje is not null)
{
    <div class="alert alert-warning">@Model.Mensaje</div>
}

<div class="buscador mb-4">
    <input type="search" id="buscar" class="form-control form-control-lg"
           placeholder="Buscar por código, medida o nombre (ej: DW-8 o 8 x 2)"
           autocomplete="off" />
    <ul id="sugerencias" class="sugerencias" hidden></ul>
</div>

@if (User.IsInRole("admin"))
{
    <a asp-page="/Nuevo" class="btn btn-primary mb-3">Nuevo producto</a>
}

<table class="table table-striped tabla-inventario">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Medida</th>
            <th class="text-end">Compra x100</th>
            <th class="text-end">Venta x100</th>
            <th class="text-end">Stock</th>
            <th class="text-end">Mínimo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Lista)
        {
            <tr class="@(p.StockBajo ? "fila-alerta" : "")">
                <td>@p.Codigo</td>
                <td>@p.Nombre</td>
                <td>@p.Medida</td>
                <td class="text-end">$ @p.PrecioCompra.ToString("N0")</td>
                <td class="text-end">$ @p.PrecioVenta.ToString("N0")</td>
                <td class="text-end">
                    @p.Stock
                    @if (p.StockBajo)
                    {
                        <span class="badge bg-danger ms-2">BAJO</span>
                    }
                </td>
                <td class="text-end">@p.StockMinimo</td>
                <td class="text-nowrap">
                <a asp-page="/Movimientos" asp-route-id="@p.Id" class="btn btn-outline-secondary">Movimientos</a>
                    @if (User.IsInRole("admin"))
                  {
                     <a asp-page="/Editar" asp-route-id="@p.Id" class="btn btn-outline-primary">Editar</a>
                      <form method="post" asp-page-handler="Eliminar" asp-route-id="@p.Id" class="d-inline"
                              onsubmit="return confirm('¿Eliminar este producto?');">
                           <button type="submit" class="btn btn-outline-danger">Eliminar</button>
                    </form>
                   }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        const input = document.getElementById('buscar');
        const lista = document.getElementById('sugerencias');
        let temporizador;

        const pesos = n => '$ ' + Number(n).toLocaleString('es-CO', { maximumFractionDigits: 0 });

        input.addEventListener('input', () => {
            clearTimeout(temporizador);
            temporizador = setTimeout(buscar, 250);
        });

        async function buscar() {
            const q = input.value.trim();
            if (q.length === 0) {
                lista.hidden = true;
                return;
            }

            const resp = await fetch(`?handler=Buscar&q=${encodeURIComponent(q)}`);
            const datos = await resp.json();
            mostrar(datos);
        }

        function mostrar(datos) {
            lista.innerHTML = '';

            if (datos.length === 0) {
                const li = document.createElement('li');
                li.textContent = 'Sin resultados';
                li.className = 'p-3 text-muted';
                lista.appendChild(li);
            }

            datos.forEach(p => {
                const li = document.createElement('li');
                const a = document.createElement('a');
                a.href = `/Editar/${p.id}`;

                const titulo = document.createElement('strong');
                titulo.textContent = `${p.codigo}  ·  ${p.medida ?? ''}`;

                const detalle = document.createElement('div');
                detalle.className = 'detalle';
                detalle.textContent = `Venta: ${pesos(p.precioVenta)}  ·  Stock: ${p.stock}` +
                                      (p.stockBajo ? '  ·  ⚠ STOCK BAJO' : '');

                a.appendChild(titulo);
                a.appendChild(detalle);
                li.appendChild(a);
                lista.appendChild(li);
            });

            lista.hidden = false;
        }

        document.addEventListener('click', e => {
            if (!e.target.closest('.buscador')) {
                lista.hidden = true;
            }
        });
    </script>
}