@page
@model Ferreteria.Pages.NuevoModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nuevo producto - Ferretería</title>
    <partial name="_Estilos" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<partial name="_Barra" />

<main id="contenido" class="container py-4" style="max-width:760px">

    <nav aria-label="Ruta de navegación" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Productos">Inventario</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nuevo producto</li>
        </ol>
    </nav>

    <header class="mb-4">
        <h1 class="h2 mb-1">Nuevo producto</h1>
        <p class="text-secondary mb-0">Completa los datos y toca Guardar.</p>
    </header>

    @if (Model.Error != null)
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    <div class="fer-card">
        <div class="fer-card-cuerpo">
            <form method="post">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="Producto_Codigo">Código</label>
                        <input asp-for="Producto.Codigo" class="form-control form-control-lg" autocomplete="off" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold" for="Producto_Nombre">Nombre</label>
                        <input asp-for="Producto.Nombre" class="form-control form-control-lg" autocomplete="off" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold" for="Producto_CodigoBarras">
                            <i class="bi bi-upc-scan me-1" aria-hidden="true"></i>Código de barras del proveedor
                        </label>
                        <input asp-for="Producto.CodigoBarras" class="form-control form-control-lg js-codigo-barras" autocomplete="off"
                               placeholder="Pase el lector por el código, o déjelo vacío" aria-describedby="ayudaBarras" />
                        <div id="ayudaBarras" class="form-text">Si el producto no trae código de barras, el sistema le crea uno propio que no se repite.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="Producto_Medida">Medida</label>
                        <input asp-for="Producto.Medida" class="form-control form-control-lg" placeholder="Ej.: 1/4 x 2" autocomplete="off" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="Producto_PrecioCompra">Precio de compra</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">$</span>
                            <input asp-for="Producto.PrecioCompra" type="number" step="0.01" min="0" inputmode="decimal" class="form-control js-precio-compra" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="Producto_PrecioPor">El precio es por</label>
                        <select asp-for="Producto.PrecioPor" class="form-select form-select-lg js-precio-por">
                            <option value="1">Unidad</option>
                            <option value="100">100 unidades (ciento)</option>
                        </select>
                        <div class="form-text">En los pedidos se cobra por unidad: si es por 100, se divide entre 100.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="Producto_MargenPct">Ganancia (%)</label>
                        <input asp-for="Producto.MargenPct" type="number" step="1" min="0" max="1000" inputmode="numeric" class="form-control form-control-lg js-margen" />
                        <div class="form-text">Precio de venta<span class="js-por"></span>: <strong class="js-precio-venta">$ 0</strong> · 100 % = el doble del precio de compra.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="Producto_Stock">Stock inicial</label>
                        <input asp-for="Producto.Stock" type="number" min="0" inputmode="numeric" class="form-control form-control-lg" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="Producto_StockMinimo">Stock mínimo</label>
                        <input asp-for="Producto.StockMinimo" type="number" min="0" inputmode="numeric" class="form-control form-control-lg" />
                        <div class="form-text">Cuando queden estas unidades o menos, el producto se marca como "por agotarse".</div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-fer btn-lg flex-grow-1">
                        <i class="bi bi-check-lg me-2" aria-hidden="true"></i>Guardar producto
                    </button>
                    <a class="btn btn-fer-outline btn-lg" href="/Productos">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

</main>

<script>
    // Precio de venta en vivo: precio de compra + ganancia
    (function () {
        var compra = document.querySelector('.js-precio-compra');
        var margen = document.querySelector('.js-margen');
        var venta = document.querySelector('.js-precio-venta');
        if (!compra || !margen || !venta) return;
        function calcular() {
            var v = (parseFloat(compra.value) || 0) * (1 + (parseFloat(margen.value) || 0) / 100);
            venta.textContent = '$ ' + Math.round(v).toLocaleString('es-CO');
            var por = document.querySelector('.js-precio-por'), etiqueta = document.querySelector('.js-por');
            if (por && etiqueta) etiqueta.textContent = por.value === '100'
                ? ' x100 (' + '$ ' + Math.round(v / 100).toLocaleString('es-CO') + ' c/u)' : '';
        }
        compra.addEventListener('input', calcular);
        var porSel = document.querySelector('.js-precio-por');
        if (porSel) porSel.addEventListener('change', calcular);
        margen.addEventListener('input', calcular);
    })();
</script>
</body>
</html>
