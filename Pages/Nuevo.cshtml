@page
@model Ferreteria.Pages.NuevoModel
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nuevo producto</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { font-size: 1.1rem; }
        .form-control, .btn { font-size: 1.1rem; min-height: 3rem; }
    </style>
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="/Productos">Ferretería</a>
    <a class="btn btn-outline-light btn-sm" href="/Productos">Volver al inventario</a>
</nav>

<div class="container py-3" style="max-width: 700px;">
    <h1 class="h3 mb-3">Nuevo producto</h1>

    @if (Model.Error != null)
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    <form method="post" class="bg-white rounded shadow-sm p-3">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold" for="Producto_Codigo">Código</label>
                <input asp-for="Producto.Codigo" class="form-control" />
            </div>
            <div class="col-md-8">
                <label class="form-label fw-semibold" for="Producto_Nombre">Nombre</label>
                <input asp-for="Producto.Nombre" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="Producto_Medida">Medida</label>
                <input asp-for="Producto.Medida" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="Producto_PrecioCompra">Precio de compra (unidad)</label>
                <input asp-for="Producto.PrecioCompra" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="Producto_Stock">Stock inicial</label>
                <input asp-for="Producto.Stock" type="number" min="0" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="Producto_StockMinimo">Stock mínimo</label>
                <input asp-for="Producto.StockMinimo" type="number" min="0" class="form-control" />
            </div>
        </div>
        <button type="submit" class="btn btn-success w-100 mt-4">Guardar producto</button>
    </form>
</div>
</body>
</html>