@page "/Pedidos/Nuevo"
@model NuevoPedidoModel
@using Ferreteria.Pages.Pedidos
@using System.Globalization
@{
    Layout = null;
    int tope = (int)Math.Floor(Model.DescuentoMaximo);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nuevo pedido - Ferretería</title>
    <partial name="_Estilos" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<partial name="_Barra" />

<main id="contenido" class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Nuevo pedido</h1>
            <p class="text-secondary mb-0">Vendedor: @Model.NombreVendedor</p>
        </div>
        <div class="fer-card px-4 py-3 text-center">
            <div class="small text-secondary">Descuento máximo permitido</div>
            <div class="fs-4 fw-bold">@Model.DescuentoMaximo.ToString("0.##", CultureInfo.InvariantCulture)%</div>
        </div>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <strong>No se pudo guardar el pedido:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var error in ModelState.Values.SelectMany(v => v.Errors).Where(e => !string.IsNullOrEmpty(e.ErrorMessage)))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" id="formPedido">

        <div class="row g-4">

            <div class="col-12 col-xl-8">

                <section class="fer-card mb-4" aria-labelledby="titulo-cliente">
                    <div class="fer-card-cuerpo">
                        <h2 id="titulo-cliente" class="h5 mb-3">1. Cliente</h2>
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="celular1">
                                    Celular principal <span class="text-danger" aria-hidden="true">*</span>
                                </label>
                                <input id="celular1" name="Cliente.Celular1" type="tel" inputmode="numeric"
                                       class="form-control form-control-lg"
                                       value="@Model.Cliente.Celular1" autocomplete="off" required
                                       aria-describedby="ayuda-celular" />
                                <div id="ayuda-celular" class="form-text">
                                    Escribe el celular y pasa al siguiente campo. Si el cliente ya existe, sus datos se llenan solos.
                                </div>
                                <div id="estado-cliente" class="form-text" role="status" aria-live="polite"></div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="celular2">Otro celular</label>
                                <input id="celular2" name="Cliente.Celular2" type="tel" inputmode="numeric"
                                       class="form-control form-control-lg"
                                       value="@Model.Cliente.Celular2" autocomplete="off" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="nombreFerreteria">Nombre de la ferretería</label>
                                <input id="nombreFerreteria" name="Cliente.NombreFerreteria" type="text"
                                       class="form-control form-control-lg"
                                       value="@Model.Cliente.NombreFerreteria" autocomplete="off" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="nombreCliente">
                                    Nombre del cliente <span class="text-danger" aria-hidden="true">*</span>
                                </label>
                                <input id="nombreCliente" name="Cliente.NombreCliente" type="text"
                                       class="form-control form-control-lg"
                                       value="@Model.Cliente.NombreCliente" autocomplete="off" required />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold" for="direccion">
                                    Dirección <span class="text-danger" aria-hidden="true">*</span>
                                </label>
                                <input id="direccion" name="Cliente.Direccion" type="text"
                                       class="form-control form-control-lg"
                                       value="@Model.Cliente.Direccion" autocomplete="off" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="ubicacion">Ubicación</label>
                                <input id="ubicacion" name="Cliente.Ubicacion" type="text"
                                       class="form-control form-control-lg"
                                       value="@Model.Cliente.Ubicacion" autocomplete="off" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="horario">Horario</label>
                                <input id="horario" name="Cliente.Horario" type="text"
                                       class="form-control form-control-lg"
                                       value="@Model.Cliente.Horario" autocomplete="off" />
                            </div>

                        </div>
                    </div>
                </section>

                <section class="fer-card" aria-labelledby="titulo-productos">
                    <div class="fer-card-cuerpo pb-0">
                        <h2 id="titulo-productos" class="h5 mb-3">2. Productos</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table fer-tabla mb-0">
                            <caption class="visually-hidden">Productos del pedido. Elige el producto y escribe la cantidad.</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Producto</th>
                                    <th scope="col" style="width: 130px;">Cantidad</th>
                                    <th scope="col" class="text-end">Precio</th>
                                    <th scope="col" class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Lineas.Count; i++)
                                {
                                    var linea = Model.Lineas[i];
                                    <tr>
                                        <td>
                                            <label class="visually-hidden" for="producto-@i">Producto de la línea @(i + 1)</label>
                                            <select id="producto-@i"
                                                    name="Lineas[@i].ProductoId"
                                                    class="form-select linea-producto"
                                                    data-linea="@i">
                                                <option value="0">Elige un producto</option>
                                                @foreach (var p in Model.Productos)
                                                {
                                                    <option value="@p.Id"
                                                            selected="@(p.Id == linea.ProductoId)"
                                                            data-precio="@p.PrecioVenta.ToString(CultureInfo.InvariantCulture)">
                                                        @p.Codigo · @p.Nombre @p.Medida (stock: @p.Stock)
                                                    </option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <label class="visually-hidden" for="cantidad-@i">Cantidad de la línea @(i + 1)</label>
                                            <input id="cantidad-@i"
                                                   type="number"
                                                   name="Lineas[@i].Cantidad"
                                                   class="form-control linea-cantidad"
                                                   data-linea="@i"
                                                   min="1" max="100000" step="1"
                                                   value="@linea.Cantidad" />
                                        </td>
                                        <td class="text-end">
                                            <span id="precio-@i">—</span>
                                        </td>
                                        <td class="text-end">
                                            <span id="subtotal-@i" class="fw-semibold">—</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="fer-card-cuerpo border-top">
                        <div class="row g-3 align-items-center">
                            <div class="col-sm-4">
                                <label for="descuento" class="form-label fw-semibold mb-0">Descuento (opcional)</label>
                            </div>
                            <div class="col-sm-8">
                                <select id="descuento" name="DescuentoElegido" class="form-select form-select-lg"
                                        aria-describedby="ayuda-descuento" @(tope == 0 ? "disabled" : "")>
                                    @for (int d = 0; d <= tope; d++)
                                    {
                                        <option value="@d" selected="@(d == (int)Model.DescuentoElegido)">
                                            @(d == 0 ? "Sin descuento" : d + " %")
                                        </option>
                                    }
                                </select>
                                <div id="ayuda-descuento" class="form-text">
                                    @if (tope == 0)
                                    {
                                        <span>Tu usuario no tiene descuento permitido.</span>
                                    }
                                    else
                                    {
                                        <span>Puedes elegir hasta @tope %. Si no eliges nada, el pedido va sin descuento.</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="fer-card-cuerpo pt-0 small text-secondary">
                        Solo aparecen productos con existencias. Si necesitas más filas, guarda el pedido y crea otro.
                    </div>
                </section>

            </div>

            <div class="col-12 col-xl-4">
                <aside class="fer-card position-sticky" style="top: 1rem;" aria-labelledby="titulo-resumen">
                    <div class="fer-card-cuerpo">
                        <h2 id="titulo-resumen" class="h5 mb-3">3. Resumen</h2>

                        <dl class="row mb-0" aria-live="polite">
                            <dt class="col-7">Subtotal</dt>
                            <dd class="col-5 text-end" id="resumen-subtotal">$ 0</dd>

                            <dt class="col-7" id="etiqueta-descuento">Descuento (0%)</dt>
                            <dd class="col-5 text-end" id="resumen-descuento">$ 0</dd>

                            <dt class="col-7 fs-5 pt-2 border-top">Total</dt>
                            <dd class="col-5 text-end fs-4 fw-bold pt-2 border-top" id="resumen-total">$ 0</dd>
                        </dl>

                        <p class="small text-secondary mt-3 mb-4">
                            El total final lo calcula el sistema al guardar.
                        </p>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-fer btn-lg">
                                <i class="bi bi-check2-circle me-2" aria-hidden="true"></i>Guardar pedido
                            </button>
                            <a href="/Pedidos/Lista" class="btn btn-fer-outline">Cancelar</a>
                        </div>
                    </div>
                </aside>
            </div>

        </div>
    </form>

</main>

<script>
    const formato = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
    const selDescuento = document.getElementById('descuento');

    function recalcular() {
        let subtotal = 0;

        document.querySelectorAll('.linea-producto').forEach(function (sel) {
            const i = sel.dataset.linea;
            const opcion = sel.options[sel.selectedIndex];
            const precio = Number(opcion && opcion.dataset.precio ? opcion.dataset.precio : 0);
            const cantidad = Number(document.getElementById('cantidad-' + i).value || 0);
            const linea = precio * cantidad;

            document.getElementById('precio-' + i).textContent = precio > 0 ? formato.format(precio) : '—';
            document.getElementById('subtotal-' + i).textContent = linea > 0 ? formato.format(linea) : '—';
            subtotal += linea;
        });

        const pctDescuento = Number(selDescuento ? selDescuento.value : 0);
        const descuento = subtotal * pctDescuento / 100;
        const total = Math.round(subtotal - descuento);

        document.getElementById('etiqueta-descuento').textContent = 'Descuento (' + pctDescuento + '%)';
        document.getElementById('resumen-subtotal').textContent = formato.format(subtotal);
        document.getElementById('resumen-descuento').textContent = '− ' + formato.format(descuento);
        document.getElementById('resumen-total').textContent = formato.format(total);
    }

    document.querySelectorAll('.linea-producto, .linea-cantidad').forEach(function (el) {
        el.addEventListener('input', recalcular);
        el.addEventListener('change', recalcular);
    });

    if (selDescuento) {
        selDescuento.addEventListener('change', recalcular);
    }

    document.getElementById('celular1').addEventListener('blur', async function (e) {
        const cel = e.target.value.trim();
        const estado = document.getElementById('estado-cliente');

        if (!cel) {
            estado.textContent = '';
            return;
        }

        estado.textContent = 'Buscando cliente...';

        try {
            const respuesta = await fetch('/Pedidos/Nuevo?handler=Cliente&cel=' + encodeURIComponent(cel));
            const datos = await respuesta.json();

            if (datos.encontrado) {
                document.getElementById('nombreFerreteria').value = datos.nombreFerreteria || '';
                document.getElementById('nombreCliente').value = datos.nombreCliente || '';
                document.getElementById('direccion').value = datos.direccion || '';
                document.getElementById('ubicacion').value = datos.ubicacion || '';
                document.getElementById('horario').value = datos.horario || '';
                document.getElementById('celular2').value = datos.celular2 || '';
                estado.textContent = 'Cliente encontrado. Revisa sus datos antes de guardar.';
            } else {
                estado.textContent = 'Cliente nuevo. Escribe sus datos.';
            }
        } catch (error) {
            estado.textContent = 'No se pudo buscar el cliente. Puedes escribir los datos a mano.';
        }
    });

    recalcular();
</script>

</body>
</html>