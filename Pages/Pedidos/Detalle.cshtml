@page "/Pedidos/Detalle/{id:int}"
@model DetalleModel
@using Ferreteria.Pages.Pedidos
@{
    Layout = null;
    var p = Model.Pedido!;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pedido @p.Numero - Ferretería</title>
    <partial name="_Estilos" />
    <style>
        /* Colores de la marca El Castillo (tomados del letrero) */
        :root {
            --ec-negro: #111111;
            --ec-grafito: #1c1c1c;
            --ec-superficie: #262626;
            --ec-amarillo: #f5b700;
            --ec-amarillo-suave: #ffd54a;
            --ec-texto: #f5f5f5;
            --ec-texto-suave: #b5b5b5;
            --ec-borde: #3a3a3a;
        }

        body {
            background: var(--ec-grafito);
            color: var(--ec-texto);
        }

        .ec-nav {
            background: var(--ec-negro);
            border-bottom: 4px solid var(--ec-amarillo);
        }

        .ec-nav .ec-logo {
            height: 56px;
            width: auto;
            border-radius: 6px;
        }

        .ec-nav .ec-marca {
            color: var(--ec-amarillo);
            font-weight: 800;
            font-size: 1.15rem;
            text-decoration: none;
            letter-spacing: 0.02em;
        }

        .ec-nav .btn-light {
            background: var(--ec-amarillo);
            border-color: var(--ec-amarillo);
            color: var(--ec-negro);
            font-weight: 700;
        }

        .ec-nav .btn-light:hover {
            background: var(--ec-amarillo-suave);
            border-color: var(--ec-amarillo-suave);
        }

        .ec-nav .btn-outline-light {
            color: var(--ec-texto);
            border-color: var(--ec-texto-suave);
        }

        .ec-nav .btn-outline-light:hover {
            background: var(--ec-superficie);
            color: var(--ec-amarillo);
        }

        .ec-tarjeta {
            background: var(--ec-superficie);
            border: 1px solid var(--ec-borde);
            border-top: 4px solid var(--ec-amarillo);
            border-radius: 12px;
            color: var(--ec-texto);
        }

        .ec-tarjeta .text-secondary,
        .text-secondary {
            color: var(--ec-texto-suave) !important;
        }

        .ec-titulo {
            color: var(--ec-amarillo);
        }

        .ec-tabla {
            --bs-table-color: var(--ec-texto);
            --bs-table-bg: var(--ec-superficie);
            --bs-table-border-color: var(--ec-borde);
            --bs-table-hover-bg: #303030;
            color: var(--ec-texto);
        }

        .ec-tabla thead th {
            background: var(--ec-negro);
            color: var(--ec-amarillo);
            border-bottom: 2px solid var(--ec-amarillo);
        }

        .ec-tabla tfoot tr:last-child th,
        .ec-tabla tfoot tr:last-child td {
            color: var(--ec-amarillo);
        }

        .ec-boton {
            background: var(--ec-amarillo);
            border: 2px solid var(--ec-amarillo);
            color: var(--ec-negro);
            font-weight: 700;
            border-radius: 10px;
        }

        .ec-boton:hover {
            background: var(--ec-amarillo-suave);
            border-color: var(--ec-amarillo-suave);
            color: var(--ec-negro);
        }

        .ec-boton-outline {
            background: transparent;
            border: 2px solid var(--ec-amarillo);
            color: var(--ec-amarillo);
            font-weight: 700;
            border-radius: 10px;
        }

        .ec-boton-outline:hover {
            background: var(--ec-amarillo);
            color: var(--ec-negro);
        }

        .ec-enlace {
            color: var(--ec-amarillo-suave);
        }

        .ec-estado {
            background: var(--ec-amarillo);
            color: var(--ec-negro);
            font-weight: 700;
            border-radius: 999px;
            padding: 0.35rem 0.9rem;
        }

        /* Solo se usa al imprimir. En pantalla no afecta nada. */
        .solo-imprimir { display: none; }

        @@media print {
            @@page {
                size: letter portrait;
                margin: 12mm;
            }

            html, body {
                background: #ffffff !important;
                color: #000000 !important;
                font-size: 10pt !important;
            }

            /* Ocultar lo que no sirve en papel */
            .no-imprimir,
            .fer-nav {
                display: none !important;
            }

            .solo-imprimir {
                display: block !important;
                border-bottom: 2px solid #000;
                margin-bottom: 10px;
                padding-bottom: 6px;
            }

            .solo-imprimir h1 {
                font-size: 16pt;
                margin: 0 0 2px 0;
            }

            .solo-imprimir p {
                margin: 0;
                font-size: 10pt;
            }

            main.container {
                max-width: 100% !important;
                width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            /* Tarjetas: sin sombra, borde simple, sin recortes */
            .fer-card,
            .ec-tarjeta,
            .card {
                box-shadow: none !important;
                border: 1px solid #999 !important;
                background: #ffffff !important;
                border-radius: 0 !important;
                overflow: visible !important;
                break-inside: avoid;
            }

            /* Las dos columnas de arriba se apilan para que quepan en el ancho de la hoja */
            .row > [class*="col-"] {
                flex: 0 0 100% !important;
                max-width: 100% !important;
            }

            /* Quitar el scroll horizontal y dejar que la tabla ocupe todo el ancho */
            .table-responsive {
                overflow: visible !important;
            }

            .table {
                --bs-table-color: #000000;
                --bs-table-bg: #ffffff;
                --bs-table-border-color: #999999;
                width: 100% !important;
                font-size: 10pt;
                margin-bottom: 0;
            }

            .table th,
            .table td {
                color: #000000 !important;
                background: #ffffff !important;
                padding: 4px 6px !important;
                word-break: break-word;
                white-space: normal !important;
            }

            /* Encabezado de la tabla en negrita y con línea debajo */
            .table thead th {
                font-weight: 700;
                border-bottom: 2px solid #000 !important;
            }

            /* Cada fila completa queda en la misma hoja */
            .table tr {
                break-inside: avoid;
            }

            .table thead {
                display: table-header-group;
            }

            .table tfoot th,
            .table tfoot td {
                border-top: 1px solid #999 !important;
            }

            .table tfoot tr:last-child td,
            .table tfoot tr:last-child th {
                border-top: 2px solid #000 !important;
                font-weight: 700;
            }

            /* Textos grises o de color se vuelven negros */
            .text-secondary,
            .text-muted,
            .small,
            small {
                color: #000000 !important;
            }

            /* Los enlaces de celular se ven como texto normal */
            a {
                color: #000000 !important;
                text-decoration: none !important;
            }

            .estado,
            .badge {
                border: 1px solid #000 !important;
                background: #ffffff !important;
                color: #000000 !important;
            }

            h1, h2, h3, h4, h5 {
                color: #000000 !important;
                break-after: avoid;
            }

            dt, dd {
                color: #000000 !important;
            }

            section {
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<partial name="_Barra" />

<main id="contenido" class="container py-4">

    <nav aria-label="Ruta de navegación" class="mb-3 no-imprimir">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/Pedidos/Lista">Pedidos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@p.Numero</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-success no-imprimir" role="status">@Model.Mensaje</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger no-imprimir" role="alert">@Model.Error</div>
    }

    <!-- Encabezado que solo aparece en el papel -->
    <div class="solo-imprimir">
        <h1>Ferretería · Inventario y pedidos</h1>
        <p>Pedido @p.Numero · Fecha del pedido: @ListaModel.FormatearFecha(p.Fecha) · Impreso: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Pedido @p.Numero</h1>
            <p class="text-secondary mb-0">Fecha: @ListaModel.FormatearFecha(p.Fecha)</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 gap-md-3">
            <span class="estado ec-estado @ListaModel.ClaseEstado(p.Estado)">@ListaModel.EtiquetaEstado(p.Estado)</span>
            @if (Model.EsAdmin && p.Estado == "pendiente")
            {
                <a class="btn ec-boton no-imprimir" href="/Pedidos/Alistar/@p.Id">
                    <i class="bi bi-list-check me-2" aria-hidden="true"></i>Alistar
                </a>
            }
            @if (Model.EsAdmin && p.Estado != "cancelado")
            {
                <a class="btn ec-boton-outline no-imprimir" href="/Pedidos/Sticker/@p.Id">
                    <i class="bi bi-tag me-2" aria-hidden="true"></i>Sticker
                </a>
            }
            <button type="button" class="btn ec-boton-outline no-imprimir" onclick="window.print()">
                <i class="bi bi-printer me-2" aria-hidden="true"></i>Imprimir
            </button>
        </div>
    </div>

    <section class="ec-tarjeta mb-4 no-imprimir" aria-label="Avance del pedido">
        <div class="fer-card-cuerpo">
            <partial name="_PasosPedido" model="p.Estado" />
        </div>
    </section>

    <div class="row g-4 mb-4">

        <section class="col-12 col-lg-7" aria-labelledby="titulo-cliente">
            <div class="ec-tarjeta h-100">
                <div class="fer-card-cuerpo">
                    <h2 id="titulo-cliente" class="h5 mb-3">Cliente</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Ferretería</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(p.Ferreteria) ? "—" : p.Ferreteria)</dd>

                        <dt class="col-sm-4">Nombre</dt>
                        <dd class="col-sm-8">@p.Cliente</dd>

                        <dt class="col-sm-4">Dirección</dt>
                        <dd class="col-sm-8">@p.Direccion</dd>

                        <dt class="col-sm-4">Ubicación</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(p.Ubicacion) ? "—" : p.Ubicacion)</dd>

                        <dt class="col-sm-4">Horario</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(p.Horario) ? "—" : p.Horario)</dd>

                        <dt class="col-sm-4">Celular</dt>
                        <dd class="col-sm-8">
                            <a href="tel:@p.Celular1">@p.Celular1</a>
                            @if (!string.IsNullOrWhiteSpace(p.Celular2))
                            {
                                <span> · </span>
                                <a href="tel:@p.Celular2">@p.Celular2</a>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </section>

        <section class="col-12 col-lg-5" aria-labelledby="titulo-resumen">
            <div class="ec-tarjeta h-100">
                <div class="fer-card-cuerpo">
                    <h2 id="titulo-resumen" class="h5 mb-3">Resumen</h2>
                    <dl class="row mb-0">
                        @if (Model.EsAdmin)
                        {
                            <dt class="col-sm-6">Vendedor</dt>
                            <dd class="col-sm-6">@p.Vendedor</dd>
                        }
                        <dt class="col-sm-6">Descuento del vendedor</dt>
                        <dd class="col-sm-6">@p.DescuentoPct.ToString("0.##")%</dd>

                        <dt class="col-sm-6">Total del pedido</dt>
                        <dd class="col-sm-6 fs-4 fw-bold">@ListaModel.Moneda(p.Total)</dd>
                    </dl>
                </div>
            </div>
        </section>

    </div>

    @if (Model.EsAdmin)
    {
        <section class="ec-tarjeta mb-4 no-imprimir" aria-labelledby="titulo-estado">
            <div class="fer-card-cuerpo">
                <h2 id="titulo-estado" class="h5 mb-3">Cambiar estado</h2>
                <form method="post" asp-page-handler="Estado" asp-route-id="@p.Id" class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label for="nuevoEstado" class="form-label fw-semibold">Nuevo estado</label>
                        <select id="nuevoEstado" name="estado" class="form-select form-select-lg">
                            @foreach (var opcion in DetalleModel.OpcionesEstado)
                            {
                                @* Cancelar o marcar "No entregado" devuelve el stock: se pide confirmación *@
                                var confirmar = opcion.Clave == p.Estado ? null
                                    : opcion.Clave == "cancelado" ? $"¿Cancelar el pedido {p.Numero}? Los productos vuelven al inventario."
                                    : opcion.Clave == "no_entregado" ? $"¿Marcar el pedido {p.Numero} como no entregado? Los productos vuelven al inventario."
                                    : null;
                                <option value="@opcion.Clave" selected="@(opcion.Clave == p.Estado)"
                                        data-confirmar="@confirmar" data-confirmar-tipo="peligro"
                                        data-confirmar-boton="@(opcion.Clave == "cancelado" ? "Sí, cancelar pedido" : "Sí, marcar")">@opcion.Etiqueta</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 d-grid">
                        <button type="submit" class="btn ec-boton btn-lg">Actualizar estado</button>
                    </div>
                </form>
                <p class="small text-secondary mt-3 mb-0">
                    Si el pedido pasa a "No entregado" o "Cancelado", el stock vuelve al inventario.
                    Si vuelve a un estado activo, el stock se descuenta otra vez.
                </p>
            </div>
        </section>
    }

    <section aria-labelledby="titulo-productos">
        <h2 id="titulo-productos" class="h5 mb-3">Productos</h2>
        <div class="ec-tarjeta overflow-hidden">
            <div class="table-responsive">
                <table class="table ec-tabla mb-0">
                    <caption class="visually-hidden">Productos incluidos en el pedido @p.Numero</caption>
                    <thead>
                        <tr>
                            <th scope="col">Código</th>
                            <th scope="col">Producto</th>
                            <th scope="col">Medida</th>
                            <th scope="col" class="text-end">Cantidad</th>
                            <th scope="col" class="text-end">Precio unitario</th>
                            <th scope="col" class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Codigo</td>
                                <td>@item.Nombre</td>
                                <td>@item.Medida</td>
                                <td class="text-end">@item.Cantidad</td>
                                <td class="text-end">@ListaModel.Moneda(item.PrecioUnitario)</td>
                                <td class="text-end">@ListaModel.Moneda(item.Subtotal)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row" colspan="5" class="text-end">Subtotal</th>
                            <td class="text-end">@ListaModel.Moneda(Model.Subtotal)</td>
                        </tr>
                        <tr>
                            <th scope="row" colspan="5" class="text-end">Descuento (@p.DescuentoPct.ToString("0.##")%)</th>
                            <td class="text-end">− @ListaModel.Moneda(Model.MontoDescuento)</td>
                        </tr>
                        <tr>
                            <th scope="row" colspan="5" class="text-end fs-5">Total</th>
                            <td class="text-end fs-5 fw-bold">@ListaModel.Moneda(p.Total)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </section>

    <div class="d-flex flex-wrap gap-3 mt-4 no-imprimir">
        <a href="/Pedidos/Lista" class="btn ec-boton-outline">
            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Volver a pedidos
        </a>
    </div>

</main>

</body>
</html>