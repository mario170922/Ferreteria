@page "/Pedidos/Lista"
@model ListaModel
@using Ferreteria.Pages.Pedidos
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pedidos - Ferretería</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="mb-0">Pedidos</h3>
            <small class="text-muted">Últimos 3 meses</small>
        </div>
        <div class="d-flex gap-2">
            <a href="/Productos" class="btn btn-outline-secondary">Inventario</a>
            <a href="/Pedidos/Nuevo" class="btn btn-primary">+ Nuevo pedido</a>
        </div>
    </div>

    @if (Model.Pedidos.Count == 0)
    {
        <div class="alert alert-info">No hay pedidos en los últimos 3 meses.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Orden</th>
                            <th>Fecha</th>
                            <th>Ferretería</th>
                            <th>Cliente</th>
                            @if (Model.EsAdmin)
                            {
                                <th>Vendedor</th>
                            }
                            <th class="text-end">Total</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Pedidos)
                        {
                            <tr>
                                <td><strong>@p.Numero</strong></td>
                                <td>@ListaModel.FormatearFecha(p.Fecha)</td>
                                <td>@p.Ferreteria</td>
                                <td>@p.Cliente</td>
                                @if (Model.EsAdmin)
                                {
                                    <td>@p.Vendedor</td>
                                }
                                <td class="text-end">@ListaModel.Moneda(p.Total)</td>
                                <td class="text-center">
                                    <span class="badge @ListaModel.ClaseEstado(p.Estado)">@ListaModel.EtiquetaEstado(p.Estado)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
</body>
</html>