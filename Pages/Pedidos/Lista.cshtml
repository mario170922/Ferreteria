@page "/Pedidos/Lista"
@model ListaModel
@using Ferreteria.Pages.Pedidos
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pedidos - @Negocio.Nombre(User.NegocioActual())</title>
    <partial name="_Estilos" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<partial name="_Barra" />

<main id="contenido" class="container py-4">

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Pedidos</h1>
            <p class="text-secondary mb-0">
                @if (Model.EsAdmin)
                {
                    <span>Pedidos de todos los vendedores, de los últimos 3 meses.</span>
                }
                else
                {
                    <span>Solo tus pedidos de los últimos 3 meses.</span>
                }
            </p>
        </div>
        <a href="/Pedidos/Nuevo" class="btn btn-fer btn-lg">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Nuevo pedido
        </a>
    </div>

    @if (Model.Pedidos.Count == 0)
    {
        <section class="fer-card fer-vacio" aria-live="polite">
            <i class="bi bi-inbox" aria-hidden="true"></i>
            <h2 class="h5 mt-3">Todavía no hay pedidos</h2>
            <p class="mb-3">Cuando registres un pedido aparecerá aquí durante 3 meses.</p>
            <a href="/Pedidos/Nuevo" class="btn btn-fer">Crear el primer pedido</a>
        </section>
    }
    else
    {
        <div class="fer-card overflow-hidden">
            <div class="table-responsive">
                <table class="table fer-tabla fer-tabla-tarjetas mb-0">
                    <caption class="visually-hidden">Pedidos de los últimos 3 meses</caption>
                    <thead>
                        <tr>
                            <th scope="col">Orden</th>
                            <th scope="col">Fecha</th>
                            <th scope="col">Ferretería</th>
                            <th scope="col">Cliente</th>
                            @if (Model.EsAdmin)
                            {
                                <th scope="col">Vendedor</th>
                            }
                            <th scope="col" class="text-end">Total</th>
                            <th scope="col" class="text-center">Estado</th>
                            <th scope="col" class="text-center"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Pedidos)
                        {
                            <tr>
                                <td>
                                    <a class="numero-orden" href="/Pedidos/Detalle/@p.Id"
                                       aria-label="Ver detalle del pedido @p.Numero">@p.Numero</a>
                                </td>
                                <td data-etiqueta="Fecha">@ListaModel.FormatearFecha(p.Fecha)</td>
                                <td data-etiqueta="Ferretería">@p.Ferreteria</td>
                                <td data-etiqueta="Cliente">@p.Cliente</td>
                                @if (Model.EsAdmin)
                                {
                                    <td data-etiqueta="Vendedor">@p.Vendedor</td>
                                }
                                <td class="text-end" data-etiqueta="Total">@ListaModel.Moneda(p.Total)</td>
                                <td class="text-center" data-etiqueta="Estado">
                                    <span class="estado @ListaModel.ClaseEstado(p.Estado)">@ListaModel.EtiquetaEstado(p.Estado)</span>
                                </td>
                                <td class="text-center">
                                    <a class="btn btn-fer-outline btn-sm" href="/Pedidos/Detalle/@p.Id"
                                       aria-label="Ver detalle del pedido @p.Numero">
                                        <i class="bi bi-eye me-1" aria-hidden="true"></i>Ver
                                    </a>
                                    @if (Model.EsAdmin && p.Estado == "pendiente")
                                    {
                                        <a class="btn btn-fer btn-sm" href="/Pedidos/Alistar/@p.Id"
                                           aria-label="Alistar el pedido @p.Numero">
                                            <i class="bi bi-list-check me-1" aria-hidden="true"></i>Alistar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="small text-secondary mt-2">Toca el número de orden o el botón Ver para abrir el detalle.</p>
    }

</main>

</body>
</html>