@page
@model Ferreteria.Pages.Compras.CargarModel
@using Ferreteria.Pages.Pedidos
@using Ferreteria.Services
@{
    Layout = null;
    var f = Model.Factura;
    var cultura = new System.Globalization.CultureInfo("es-CO");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cargar factura de compra - @Negocio.Nombre(User.NegocioActual())</title>
    <partial name="_Estilos" />
    <style>
        .cf-subir {
            display: flex; flex-direction: column; align-items: center; gap: .75rem; text-align: center;
            padding: 2.5rem 1.5rem; border: 2px dashed rgba(245, 183, 0, .5); border-radius: var(--fer-radio);
            background: rgba(245, 183, 0, .05);
        }
        .cf-subir .bi { font-size: 3rem; color: var(--fer-naranja); }
        .cf-linea { padding: 1rem 1.1rem; border-bottom: 1px solid var(--fer-borde); }
        .cf-linea:last-child { border-bottom: 0; }
        .cf-desc { font-weight: 700; }
        .cf-detalle { font-size: .9rem; color: var(--fer-texto-suave); }
        .cf-nuevo { display: none; }
        .cf-linea.crear .cf-nuevo { display: flex; }
        .cf-linea.no-sumar { opacity: .55; }
        .cf-estado { font-size: .8rem; font-weight: 700; border-radius: 999px; padding: .15rem .6rem; }
        .cf-estado.ok { background: #b9f5c6; color: #0a3d17; }
        .cf-estado.nuevo { background: #ffe9a8; color: #4a3800; }
        .cf-estado.aprobar { background: #ffe9a8; color: #4a3800; }
        .cf-estado.sin { background: #ffc9c9; color: #6b1212; }
        .cf-linea.pendiente { box-shadow: inset 4px 0 0 var(--fer-rojo); }
    </style>
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>
<partial name="_Barra" />

<main id="contenido" class="container py-4">

    <nav aria-label="Ruta de navegación" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Compras">Compras</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cargar factura</li>
        </ol>
    </nav>

    <h1 class="h2 mb-3">Cargar factura de compra</h1>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    @if (f is null)
    {
        @* ---------- Paso 1: subir el archivo ---------- *@
        <form method="post" asp-page-handler="Leer" enctype="multipart/form-data" class="fer-card p-4">
            <label for="factura" class="cf-subir">
                <i class="bi bi-file-earmark-zip" aria-hidden="true"></i>
                <span class="fs-5 fw-semibold">Elige el archivo de la factura</span>
                <span class="text-secondary">Es el archivo que llega adjunto en el correo del proveedor junto con el PDF.
                    También sirve el .xml que viene dentro del .zip. Si solo tienes el PDF o una foto de una factura impresa,
                    también se puede: la lee la inteligencia artificial y luego revisas cada línea.</span>
                <input id="factura" name="factura" type="file" accept=".zip,.xml,.pdf,.jpg,.jpeg,.png,.webp" class="form-control form-control-lg mt-2" style="max-width: 460px" required />
            </label>
            <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn btn-fer btn-lg">
                    <i class="bi bi-search me-2" aria-hidden="true"></i>Leer factura
                </button>
            </div>
        </form>
    }
    else
    {
        @* ---------- Paso 2: revisar y guardar ---------- *@
        <section class="fer-card p-4 mb-4" aria-labelledby="titulo-factura">
            <h2 id="titulo-factura" class="h5 mb-3">Factura @f.Numero</h2>
            <div class="row g-3">
                <div class="col-md-5"><span class="text-secondary d-block small">Proveedor</span><strong>@f.ProveedorNombre</strong><span class="d-block small text-secondary">NIT @f.ProveedorNit</span></div>
                <div class="col-6 col-md-2"><span class="text-secondary d-block small">Fecha</span><strong>@f.Fecha.ToString("dd/MM/yyyy")</strong></div>
                <div class="col-6 col-md-2"><span class="text-secondary d-block small">Impuestos</span><strong>@ListaModel.Moneda(f.Impuestos)</strong></div>
                <div class="col-md-3"><span class="text-secondary d-block small">Total a pagar</span><strong class="fs-4">@ListaModel.Moneda(f.Total)</strong></div>
            </div>
        </section>

        @if (Model.LeidaConIA)
        {
            <div class="alert alert-info" role="status">
                Esta factura se leyó con inteligencia artificial desde un PDF o una foto. <strong>Revisa cada dato contra el papel</strong>
                (cantidades, precios y totales) antes de guardar.
            </div>
        }
        @if (Model.Alertas.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <div>
                    <strong>La factura no cuadra. Revísala antes de guardar:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var a in Model.Alertas) { <li>@a</li> }
                    </ul>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success" role="status">Los totales de la factura cuadran: líneas, impuestos y total a pagar.</div>
        }

        <form method="post" asp-page-handler="Guardar">
            <input type="hidden" asp-for="Archivo" />

            <div class="fer-card overflow-hidden mb-3">
                <div class="fer-card-cuerpo pb-2">
                    <h2 class="h5 mb-1">Productos de la factura (@f.Lineas.Count)</h2>
                    <p class="text-secondary small mb-0">
                        Revisa a qué producto del inventario corresponde cada uno. <strong>Automático</strong>: el sistema está seguro.
                        <strong>Requiere aprobación</strong>: marca "Aprobado" si la sugerencia es correcta.
                        <strong>Sin coincidencia</strong>: elige el producto o créalo. Nada entra al inventario hasta que guardes.
                        Si el proveedor vende por caja o paquete, escribe cuántas unidades trae cada una.
                    </p>
                </div>

                @for (var i = 0; i < f.Lineas.Count; i++)
                {
                    var l = f.Lineas[i];
                    var form = Model.Lineas.Count > i ? Model.Lineas[i] : new CargarModel.LineaForm();
                    var res = Model.Resultados.Count > i ? Model.Resultados[i] : null;
                    var clase = form.ProductoId == CargarModel.CrearNuevo ? "crear" : form.ProductoId == CargarModel.NoSumar ? "no-sumar" : "";
                    var cantidad = form.Cantidad ?? l.Cantidad;
                    <div class="cf-linea @clase" data-linea data-sugerido="@(res?.ProductoId ?? 0)" data-estado="@res?.Estado">
                        <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                            <div>
                                <div class="cf-desc">@l.Numero. @l.Descripcion</div>
                                <div class="cf-detalle">
                                    Código del proveedor @l.CodigoProveedor
                                    @if (l.CodigoBarras is not null) { <span> · <i class="bi bi-upc" aria-hidden="true"></i> @l.CodigoBarras</span> }
                                    · Facturado: @l.Cantidad.ToString("0.###", cultura) @l.Unidad
                                    @if (l.PrecioUnitario > 0) { <span> × @ListaModel.Moneda(l.PrecioUnitario)</span> }
                                    @if (l.Descuento > 0) { <span> · descuento @ListaModel.Moneda(l.Descuento)</span> }
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold">@ListaModel.Moneda(l.ValorTotal)</div>
                                <div class="cf-detalle">con impuestos (@ListaModel.Moneda(l.Impuestos))</div>
                            </div>
                        </div>

                        @if (res is not null)
                        {
                            var (claseEstado, textoEstado) = res.Estado switch
                            {
                                Homologacion.Automatico => ("ok", "Automático"),
                                Homologacion.Aprobar => ("aprobar", "Requiere aprobación"),
                                _ => ("sin", "Sin coincidencia")
                            };
                            <div class="cf-coincidencia mb-2">
                                <span class="cf-estado @claseEstado">@textoEstado · @res.Confianza %</span>
                                <span class="cf-detalle ms-1">@res.Motivo</span>
                            </div>
                        }

                        <div class="row g-2 align-items-end">
                            <div class="col-lg-6">
                                <label class="form-label small fw-semibold" for="prod-@i">Producto del inventario</label>
                                <select id="prod-@i" name="Lineas[@i].ProductoId" class="form-select js-producto">
                                    <option value="@CargarModel.Elegir" selected="@(form.ProductoId == CargarModel.Elegir)">— Elige qué producto es —</option>
                                    <option value="@CargarModel.CrearNuevo" selected="@(form.ProductoId == CargarModel.CrearNuevo)">➕ Crear producto nuevo</option>
                                    <option value="@CargarModel.NoSumar" selected="@(form.ProductoId == CargarModel.NoSumar)">No sumar al inventario (servicio, flete, etc.)</option>
                                    @foreach (var p in Model.Productos)
                                    {
                                        <option value="@p.Id" data-stock="@p.Stock" selected="@(form.ProductoId == p.Id)">@p.Texto@(p.Id == res?.ProductoId ? "  ★ sugerido" : "")</option>
                                    }
                                </select>
                                <div class="form-text js-existencia"></div>
                            </div>
                            <div class="col-6 col-lg-2">
                                <label class="form-label small fw-semibold" for="cant-@i">Cantidad</label>
                                <input id="cant-@i" name="Lineas[@i].Cantidad" type="number" min="0.001" step="any" inputmode="decimal"
                                       value="@cantidad.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control js-cantidad" />
                            </div>
                            <div class="col-6 col-lg-2">
                                <label class="form-label small fw-semibold" for="unid-@i">Unidades por cada una</label>
                                <input id="unid-@i" name="Lineas[@i].UnidadesPor" type="number" min="1" step="1" inputmode="numeric"
                                       value="@form.UnidadesPor" class="form-control js-unidades" />
                            </div>
                            <div class="col-lg-2">
                                <div class="form-text js-total-unidades" data-valor="@l.ValorTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)"></div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mt-2">
                            @if (res?.Estado == Homologacion.Aprobar || Model.LeidaConIA)
                            {
                                <div class="form-check @(Model.LeidaConIA ? "" : "js-aprobar")">
                                    <input class="form-check-input" type="checkbox" name="Lineas[@i].Aprobado" value="true" id="apr-@i" checked="@form.Aprobado" />
                                    <label class="form-check-label fw-semibold" for="apr-@i">Aprobado: sí es este producto</label>
                                </div>
                            }
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Lineas[@i].GuardarAlias" value="true" id="ali-@i" checked="@form.GuardarAlias" />
                                <label class="form-check-label" for="ali-@i">Recordar para las próximas facturas de este proveedor</label>
                            </div>
                        </div>

                        <div class="row g-2 mt-1 cf-nuevo">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold" for="cod-@i">Código del producto nuevo</label>
                                <input id="cod-@i" name="Lineas[@i].CodigoNuevo" value="@form.CodigoNuevo" maxlength="30" class="form-control" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold" for="nom-@i">Nombre del producto nuevo</label>
                                <input id="nom-@i" name="Lineas[@i].NombreNuevo" value="@form.NombreNuevo" maxlength="150" class="form-control" />
                            </div>
                        </div>
                    </div>
                }
            </div>

            <p class="small text-secondary">
                Al guardar: se suma la cantidad al inventario, el precio de compra de cada producto queda con lo que costó
                cada unidad en esta factura (impuestos incluidos) y la compra cuenta como egreso en el Resumen.
                Los productos nuevos quedan con el precio de venta según su ganancia (100 % por defecto): revísalos en Inventario.
            </p>

            <div class="d-flex flex-wrap gap-2 justify-content-end">
                <a class="btn btn-fer-outline btn-lg" href="/Compras/Cargar">Cancelar</a>
                <button type="submit" class="btn btn-fer btn-lg"
                        data-confirmar="¿Cargar la factura @f.Numero por @ListaModel.Moneda(f.Total) y sumar los productos al inventario?"
                        data-confirmar-boton="Sí, cargar">
                    <i class="bi bi-check2-circle me-2" aria-hidden="true"></i>Guardar compra
                </button>
            </div>
        </form>
    }
</main>

<script>
    // Por cada línea: muestra los campos de producto nuevo solo si se elige crear uno, la existencia
    // actual del producto elegido, cuántas unidades van a entrar y el costo por unidad.
    document.querySelectorAll('[data-linea]').forEach(function (linea) {
        var select = linea.querySelector('.js-producto');
        var cantidad = linea.querySelector('.js-cantidad');
        var unidades = linea.querySelector('.js-unidades');
        var ayuda = linea.querySelector('.js-total-unidades');
        var existencia = linea.querySelector('.js-existencia');
        var aprobar = linea.querySelector('.js-aprobar');
        var pesos = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
        function actualizar() {
            var v = select.value;
            linea.classList.toggle('crear', v === '0');
            linea.classList.toggle('no-sumar', v === '-1');
            linea.classList.toggle('pendiente', v === '-2');
            var opcion = select.options[select.selectedIndex];
            existencia.textContent = opcion && opcion.dataset.stock !== undefined ? 'Hay ' + Number(opcion.dataset.stock).toLocaleString('es-CO') + ' en inventario' : '';
            if (aprobar) aprobar.hidden = v !== linea.dataset.sugerido;
            var total = (parseFloat(cantidad.value) || 0) * (parseInt(unidades.value, 10) || 1);
            var costo = total > 0 ? parseFloat(ayuda.dataset.valor) / total : 0;
            ayuda.textContent = v === '-1' ? 'No entra al inventario'
                : 'Entran ' + total.toLocaleString('es-CO') + ' unidades · ' + pesos.format(costo) + ' c/u';
        }
        [select, cantidad, unidades].forEach(function (e) { e.addEventListener('input', actualizar); e.addEventListener('change', actualizar); });
        actualizar();
    });
</script>
</body>
</html>
