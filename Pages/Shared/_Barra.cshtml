@* Barra superior de todas las páginas. La página actual se resalta sola (ferreteria.js).
   Se usa con: <partial name="_Barra" /> *@
@using Ferreteria.Services
@{
    bool esAdmin = User.IsInRole("admin");
    var negocio = User.NegocioActual();
    var otroNegocio = negocio == Negocio.Tornilleria ? Negocio.Ferreteria : Negocio.Tornilleria;
}
<nav class="fer-nav py-2 py-md-3" aria-label="Navegación principal">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
        <a class="d-flex align-items-center gap-2 gap-md-3 text-decoration-none" href="/" aria-label="El Castillo Ferretería, ir al inicio">
            <img src="/img/logo-casita.png" alt="" style="height:48px;width:auto" />
            <span class="d-flex flex-column">
                <span class="fer-marca">El Castillo</span>
                <span class="fer-negocio-actual"><i class="bi @Negocio.Icono(negocio) me-1" aria-hidden="true"></i>@Negocio.Nombre(negocio)</span>
            </span>
        </a>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light" href="/"><i class="bi bi-house-door me-2" aria-hidden="true"></i>Inicio</a>
            <a class="btn btn-light" href="/Productos"><i class="bi bi-box-seam me-2" aria-hidden="true"></i>Inventario</a>
            <a class="btn btn-light" href="/Pedidos/Lista"><i class="bi bi-receipt me-2" aria-hidden="true"></i>Pedidos</a>
            <a class="btn btn-light" href="/Clientes"><i class="bi bi-people me-2" aria-hidden="true"></i>Clientes</a>
            @if (esAdmin || User.IsInRole(Negocio.Cajero))
            {
                <a class="btn btn-light" href="/Resumen"><i class="bi bi-bar-chart-line me-2" aria-hidden="true"></i>Resumen</a>
            }
            @if (esAdmin)
            {
                <a class="btn btn-light" href="/Compras"><i class="bi bi-cart-check me-2" aria-hidden="true"></i>Compras</a>
                <a class="btn btn-light" href="/Categorias"><i class="bi bi-tags me-2" aria-hidden="true"></i>Categorías</a>
                <a class="btn btn-light" href="/Usuarios"><i class="bi bi-person-gear me-2" aria-hidden="true"></i>Usuarios</a>
                <a class="btn btn-light" href="/Descuentos"><i class="bi bi-percent me-2" aria-hidden="true"></i>Descuentos</a>
            }
            @if (User.EsAdminGlobal())
            {
                @* El administrador global pasa al otro negocio sin volver a ingresar *@
                <form method="post" action="/CambiarNegocio" class="d-inline">
                    <input type="hidden" name="negocio" value="@otroNegocio" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light">
                        <i class="bi bi-arrow-left-right me-2" aria-hidden="true"></i>Ir a @Negocio.Nombre(otroNegocio)
                    </button>
                </form>
            }
            <a class="btn btn-outline-light" href="/Salir"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Salir</a>
        </div>
    </div>
</nav>
