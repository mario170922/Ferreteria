@* Hojas de estilo, letras y animaciones comunes a todas las páginas.
   Se usa dentro de <head> con: <partial name="_Estilos" />
   Todo se carga desde wwwroot/lib, así el sitio funciona aunque no haya internet. *@
<meta name="theme-color" content="#111111" />
<link rel="icon" type="image/png" href="/img/logo-casita.png" />
@* Para instalar el sitio en el celular como una app (manifest.webmanifest y sw.js) *@
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="apple-touch-icon" href="/img/app/apple-touch-icon.png" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="El Castillo" />
<meta name="apple-mobile-web-app-status-bar-style" content="black" />
<link rel="stylesheet" href="~/lib/bootstrap-5.3.3/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
<link rel="stylesheet" href="~/lib/barlow/barlow.css" />
<link rel="stylesheet" href="~/css/ferreteria.css" asp-append-version="true" />
<script src="~/lib/bootstrap-5.3.3/js/bootstrap.bundle.min.js" defer></script>
<script src="~/js/ferreteria.js" asp-append-version="true" defer></script>
