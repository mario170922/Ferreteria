@page
@model Ferreteria.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ingresar - Ferretería</title>
    <partial name="_Estilos" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<main id="contenido" class="fer-login">
    <section class="fer-login-card" aria-labelledby="titulo-login">

        <img src="/img/logo-casita.png" alt="Logo El Castillo Ferretería" class="fer-login-logo" />
        <h1 id="titulo-login" class="fer-login-titulo text-center mb-1">El Castillo</h1>
        <p class="text-center text-secondary mb-4">Ferretería · Inventario y pedidos</p>

        @if (Model.Mensaje is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.Mensaje</div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="NombreUsuario" class="form-label fw-semibold">Usuario</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></span>
                    <input asp-for="NombreUsuario" class="form-control" autocomplete="username" required />
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Clave" class="form-label fw-semibold">Contraseña</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                    <input asp-for="Clave" type="password" class="form-control" autocomplete="current-password" required />
                    <button type="button" class="btn btn-fer-outline" id="ver-clave" aria-label="Mostrar contraseña" aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-fer btn-lg w-100">
                <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Entrar
            </button>
        </form>

        <p class="fer-login-pie mb-0">Tornillería y ferretería · El Castillo</p>
    </section>
</main>

<script>
    // Botón del ojo: muestra u oculta la contraseña
    (function () {
        var boton = document.getElementById('ver-clave');
        var campo = document.getElementById('Clave');
        if (!boton || !campo) return;
        boton.addEventListener('click', function () {
            var ver = campo.type === 'password';
            campo.type = ver ? 'text' : 'password';
            boton.setAttribute('aria-pressed', ver);
            boton.setAttribute('aria-label', ver ? 'Ocultar contraseña' : 'Mostrar contraseña');
            boton.querySelector('i').className = ver ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
    })();
</script>

</body>
</html>