@page
@model Ferreteria.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ingresar - Ferretería</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/ferreteria.css" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<main id="contenido" class="fer-login">
    <section class="fer-login-card" aria-labelledby="titulo-login">
        <div class="fer-login-marca" aria-hidden="true">
            <i class="bi bi-tools"></i>
        </div>
        <h1 id="titulo-login" class="h3 text-center mb-1">Ferretería</h1>
        <p class="text-center text-secondary mb-4">Inventario y pedidos</p>

        @if (Model.Mensaje is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.Mensaje</div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="NombreUsuario" class="form-label fw-semibold">Usuario</label>
                <input asp-for="NombreUsuario" class="form-control form-control-lg" autocomplete="username" required />
            </div>

            <div class="mb-4">
                <label asp-for="Clave" class="form-label fw-semibold">Contraseña</label>
                <input asp-for="Clave" type="password" class="form-control form-control-lg" autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn btn-fer btn-lg w-100">
                <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Entrar
            </button>
        </form>
    </section>
</main>

</body>
</html>