@page
@model Ferreteria.Pages.LoginModel
@{
    ViewData["Title"] = "Ingresar";
}

<div style="max-width: 380px; margin: 40px auto;">
    <h1 class="mb-4">Ingresar</h1>

    @if (Model.Mensaje is not null)
    {
        <div class="alert alert-danger">@Model.Mensaje</div>
    }

    <form method="post">
        <div class="mb-3">
            <label asp-for="NombreUsuario" class="form-label">Usuario</label>
            <input asp-for="NombreUsuario" class="form-control form-control-lg" autocomplete="username" />
        </div>

        <div class="mb-3">
            <label asp-for="Clave" class="form-label">Contraseña</label>
            <input asp-for="Clave" type="password" class="form-control form-control-lg" autocomplete="current-password" />
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">Entrar</button>
    </form>
</div>