@page "{id:int}"
@model Ferreteria.Pages.EditarModel
@using System.Globalization
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editar producto - @Negocio.Nombre(User.NegocioActual())</title>
    <partial name="_Estilos" />
    <style>
        .miniatura {
            width: 140px;
            height: 105px;
            object-fit: cover;
            border-radius: 0.5rem;
            background: #2a2a2a;
            flex-shrink: 0;
        }

        .sin-imagen {
            display: flex;
            align-items: center;
            justify-content: center;
            color: #b8b8b8;
            font-size: 0.9rem;
            border: 1px dashed #555;
        }

        .caja-categoria {
            border: 1px solid #444;
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
            height: 100%;
        }
    </style>
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<partial name="_Barra" />

<main id="contenido" class="container py-4" style="max-width: 960px;">

    <div class="mb-4">
        <h1 class="h2 mb-1">Editar producto</h1>
        <p class="text-secondary mb-0">Código @Model.Form.Codigo</p>
    </div>

    @if (Model.Mensaje is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.Mensaje</div>
    }

    <form method="post" enctype="multipart/form-data" class="fer-card p-4">
        <input type="hidden" asp-for="Form.Id" />

        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-semibold" for="Form_Codigo">Código</label>
                <input asp-for="Form.Codigo" class="form-control" maxlength="50" required />
            </div>
            <div class="col-md-9">
                <label class="form-label fw-semibold" for="Form_Nombre">Nombre</label>
                <input asp-for="Form.Nombre" class="form-control" maxlength="200" required />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold" for="Form_CodigoBarras">
                    <i class="bi bi-upc-scan me-1" aria-hidden="true"></i>Código de barras
                </label>
                <input asp-for="Form.CodigoBarras" class="form-control js-codigo-barras" autocomplete="off"
                       placeholder="Pase el lector por el código, o déjelo vacío" aria-describedby="ayudaBarras" />
                <div id="ayudaBarras" class="form-text">Si lo deja vacío, el sistema le crea uno propio que no se repite.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="Form_Medida">Medida</label>
                <input asp-for="Form.Medida" class="form-control" maxlength="100" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" for="Form_PrecioCompra">Precio de compra</label>
                <input asp-for="Form.PrecioCompra" type="number" step="0.01" min="0" class="form-control js-precio-compra" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" for="Form_PrecioPor">El precio es por</label>
                <select asp-for="Form.PrecioPor" class="form-select js-precio-por">
                    <option value="1">Unidad</option>
                    <option value="100">100 unidades (ciento)</option>
                </select>
                <div class="form-text">En los pedidos se cobra por unidad: si es por 100, se divide entre 100.</div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" for="Form_MargenPct">Ganancia (%)</label>
                <input asp-for="Form.MargenPct" type="number" step="1" min="0" max="1000" class="form-control js-margen" />
                <div class="form-text">
                    Precio de venta<span class="js-por">@(Model.Form.PrecioPor == 100 ? " x100" : "")</span>: <strong class="js-precio-venta">$ @((Model.Form.PrecioCompra * (1 + Model.Form.MargenPct / 100m)).ToString("N0", new CultureInfo("es-CO")))</strong>
                    <span class="d-block">100 % = el doble del precio de compra.</span>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" for="Form_StockMinimo">Stock mínimo</label>
                <input asp-for="Form.StockMinimo" type="number" min="0" class="form-control" />
                <div class="form-text">El stock se modifica desde Movimientos.</div>
            </div>
        </div>

        <h2 class="h5 mt-4">Imagen</h2>
        <div class="d-flex flex-wrap gap-3 align-items-start">
            @if (!string.IsNullOrEmpty(Model.ImagenActual))
            {
                <img src="/@Model.ImagenActual" class="miniatura" alt="Imagen de @Model.Form.Nombre" />
            }
            else
            {
                <div class="miniatura sin-imagen"><img class="fer-sin-foto" src="@Ferreteria.Services.DibujoSinFoto.Ruta(Model.Form.Nombre)" alt="Sin foto" /></div>
            }

            <div class="flex-grow-1">
                <label class="form-label fw-semibold" for="Imagen">Cargar o cambiar imagen (opcional)</label>
                <input id="Imagen" name="Imagen" type="file" accept="image/*" class="form-control" />
                <div class="form-text">
                    Puede elegirla desde la computadora o desde el celular. Se reduce automáticamente.
                </div>
            </div>
        </div>

        <h2 class="h5 mt-4">Categorías y subcategorías</h2>
        <p class="text-secondary small">
            Marca las categorías donde está el producto. Si marcas una subcategoría, la categoría queda asignada al guardar.
        </p>

        @if (Model.Categorias.Count == 0)
        {
            <p class="text-secondary">Todavía no hay categorías. Se crean en la pantalla de Categorías.</p>
        }

        <div class="row g-3">
            @foreach (var cat in Model.Categorias)
            {
                <div class="col-md-6">
                    <div class="caja-categoria">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Form.CategoriaIds"
                                   value="@cat.Id" id="cat-@cat.Id"
                                   checked="@(Model.Form.CategoriaIds.Contains(cat.Id))" />
                            <label class="form-check-label fw-semibold" for="cat-@cat.Id">@cat.Nombre</label>
                        </div>

                        @foreach (var sub in cat.Subcategorias)
                        {
                            <div class="form-check ms-4">
                                <input class="form-check-input" type="checkbox" name="Form.SubcategoriaIds"
                                       value="@sub.Id" id="sub-@sub.Id"
                                       checked="@(Model.Form.SubcategoriaIds.Contains(sub.Id))" />
                                <label class="form-check-label" for="sub-@sub.Id">@sub.Nombre</label>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-fer">Guardar cambios</button>
            <a asp-page="/Productos" class="btn btn-outline-light">Cancelar</a>
        </div>
    </form>

    @if (Model.UltimasCompras.Count > 0)
    {
        <section class="fer-card overflow-hidden mt-4" aria-labelledby="titulo-compras">
            <div class="fer-card-cuerpo pb-2">
                <h2 id="titulo-compras" class="h5 mb-0"><i class="bi bi-receipt me-2" aria-hidden="true"></i>Últimas compras de este producto</h2>
            </div>
            <div class="table-responsive">
                <table class="table fer-tabla mb-0">
                    <thead><tr><th>Fecha</th><th>Proveedor</th><th>Factura</th><th class="text-end">Unidades</th><th class="text-end">Costo por unidad</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.UltimasCompras)
                        {
                            <tr>
                                <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@c.Proveedor</td>
                                <td>@c.Factura</td>
                                <td class="text-end">@c.Unidades.ToString("0.##")</td>
                                <td class="text-end">@c.CostoUnidad.ToString("C0", new CultureInfo("es-CO"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

</main>

<script>
    // Precio de venta en vivo: precio de compra + ganancia
    (function () {
        var compra = document.querySelector('.js-precio-compra');
        var margen = document.querySelector('.js-margen');
        var venta = document.querySelector('.js-precio-venta');
        if (!compra || !margen || !venta) return;
        function calcular() {
            var v = (parseFloat(compra.value) || 0) * (1 + (parseFloat(margen.value) || 0) / 100);
            venta.textContent = '$ ' + Math.round(v).toLocaleString('es-CO');
            var por = document.querySelector('.js-precio-por'), etiqueta = document.querySelector('.js-por');
            if (por && etiqueta) etiqueta.textContent = por.value === '100'
                ? ' x100 (' + '$ ' + Math.round(v / 100).toLocaleString('es-CO') + ' c/u)' : '';
        }
        compra.addEventListener('input', calcular);
        var porSel = document.querySelector('.js-precio-por');
        if (porSel) porSel.addEventListener('change', calcular);
        margen.addEventListener('input', calcular);
    })();
</script>
</body>
</html>