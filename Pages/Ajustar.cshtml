@page "{id:int}"
@model AjustarModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ajustar inventario - Ferretería</title>
    <partial name="_Estilos" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<partial name="_Barra" />

<main id="contenido" class="container py-4" style="max-width:640px">

    <nav aria-label="Ruta de navegación" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Productos">Inventario</a></li>
            <li class="breadcrumb-item"><a href="/Movimientos/@Model.Id">Movimientos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Ajustar</li>
        </ol>
    </nav>

    <header class="mb-4">
        <h1 class="h2 mb-1">Ajustar inventario</h1>
        <p class="text-secondary mb-0">Usa esto cuando el conteo físico no coincide con el sistema.</p>
    </header>

    @if (Model.Error != null)
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    <div class="fer-card">
        <div class="fer-card-cuerpo">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <div class="fs-5 fw-bold">@Model.Nombre</div>
                    <div class="text-secondary">@(string.IsNullOrWhiteSpace(Model.Medida) ? "Sin medida" : Model.Medida)</div>
                </div>
                <div class="fer-cifra py-2 px-4">
                    <div class="fer-cifra-etiqueta">Stock actual</div>
                    <div class="fer-cifra-valor">@Model.StockActual.ToString("N0", new System.Globalization.CultureInfo("es-CO"))</div>
                </div>
            </div>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="NuevoStock">Stock correcto</label>
                    <input asp-for="NuevoStock" type="number" min="0" inputmode="numeric" class="form-control form-control-lg" />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold" for="Motivo">Motivo del ajuste</label>
                    <input asp-for="Motivo" class="form-control form-control-lg" placeholder="Ej.: conteo físico, producto dañado" />
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-fer btn-lg flex-grow-1">
                        <i class="bi bi-check-lg me-2" aria-hidden="true"></i>Guardar ajuste
                    </button>
                    <a class="btn btn-fer-outline btn-lg" href="/Movimientos/@Model.Id">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

</main>

</body>
</html>
