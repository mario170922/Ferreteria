@page
@model Ferreteria.Pages.UsuariosModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Usuarios - Ferretería</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/ferreteria.css" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<nav class="fer-nav py-3" aria-label="Navegación principal">
    <div class="container d-flex flex-wr<a class="d-flex align-items-center gap-3 text-decoration-none" href="/">
    <img src="/img/logo-casita.png" alt="Logo El Castillo Ferretería" style="height:56px;width:auto" />
    <span class="fer-marca d-none d-md-inline">Inventario y pedidos</span>
</a>
        
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light" href="/">Inicio</a>
            <a class="btn btn-light" href="/Productos">Inventario</a>
            <a class="btn btn-light" href="/Pedidos/Lista">Pedidos</a>
            <a class="btn btn-light" href="/Descuentos">Descuentos</a>
            <a class="btn btn-outline-light" href="/Salir">Salir</a>
        </div>
    </div>
</nav>

<main id="contenido" class="container py-4">

    <header class="mb-4">
        <h1 class="h2 mb-1">Usuarios</h1>
        <p class="text-secondary mb-0">Crea cuentas para vendedores y administradores, y activa o desactiva las existentes.</p>
    </header>

    @if (Model.Mensaje is not null)
    {
        <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") mb-4" role="@(Model.EsError ? "alert" : "status")">
            @Model.Mensaje
        </div>
    }

    <div class="row g-4">

        <section class="col-12 col-lg-5" aria-labelledby="titulo-crear">
            <div class="fer-card h-100">
                <div class="fer-card-cuerpo">
                    <h2 id="titulo-crear" class="h5 mb-3">Crear usuario</h2>

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="NombreUsuario" class="form-label fw-semibold">Usuario</label>
                            <input asp-for="NombreUsuario" class="form-control form-control-lg" placeholder="Ej.: vendedor-2" autocomplete="off" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Clave" class="form-label fw-semibold">Contraseña</label>
                            <input asp-for="Clave" type="password" class="form-control form-control-lg" autocomplete="new-password" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Rol" class="form-label fw-semibold">Rol</label>
                            <select asp-for="Rol" class="form-select form-select-lg">
                                <option value="vendedor">Vendedor</option>
                                <option value="admin">Administrador</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-fer btn-lg w-100">
                            <i class="bi bi-person-plus me-2" aria-hidden="true"></i>Crear usuario
                        </button>
                    </form>
                </div>
            </div>
        </section>

        <section class="col-12 col-lg-7" aria-labelledby="titulo-lista">
            <div class="fer-card overflow-hidden h-100">
                <div class="fer-card-cuerpo pb-2">
                    <h2 id="titulo-lista" class="h5 mb-0">Usuarios existentes</h2>
                </div>

                <div class="table-responsive">
                    <table class="table fer-tabla mb-0">
                        <caption class="visually-hidden">Usuarios registrados en el sistema</caption>
                        <thead>
                            <tr>
                                <th scope="col">Usuario</th>
                                <th scope="col">Rol</th>
                                <th scope="col">Estado</th>
                                <th scope="col"><span class="visually-hidden">Acciones</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.Lista)
                            {
                                <tr>
                                    <td><strong>@u.NombreUsuario</strong></td>
                                    <td>@(u.Rol == "admin" ? "Administrador" : "Vendedor")</td>
                                    <td>
                                        @if (u.Activo)
                                        {
                                            <span class="estado etiqueta-entrada">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="estado estado-cancelado">Desactivado</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (u.NombreUsuario != "admin")
                                        {
                                            <form method="post" asp-page-handler="CambiarActivo" asp-route-id="@u.Id" class="d-inline">
                                                <button type="submit" class="btn btn-fer-outline btn-sm">
                                                    @(u.Activo ? "Desactivar" : "Activar")
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

    </div>

</main>

</body>
</html>