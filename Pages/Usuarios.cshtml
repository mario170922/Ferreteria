@page
@model Ferreteria.Pages.UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>

<a asp-page="/Productos" class="btn btn-secondary mb-3">Volver al inventario</a>

@if (Model.Mensaje is not null)
{
    <div class="alert @(Model.EsError ? "alert-danger" : "alert-success")">@Model.Mensaje</div>
}

<h3 class="mt-3">Crear usuario</h3>

<form method="post" class="row g-3" style="max-width: 760px;">
    <div class="col-md-4">
        <label class="form-label">Usuario</label>
        <input asp-for="NombreUsuario" class="form-control" placeholder="Ej: vendedor-1" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Contraseña</label>
        <input asp-for="Clave" class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Rol</label>
        <select asp-for="Rol" class="form-select">
            <option value="vendedor">Vendedor</option>
            <option value="admin">Administrador</option>
        </select>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary btn-lg">Crear usuario</button>
    </div>
</form>

<h3 class="mt-5">Usuarios existentes</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Rol</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Lista)
        {
            <tr>
                <td>@u.NombreUsuario</td>
                <td>@(u.Rol == "admin" ? "Administrador" : "Vendedor")</td>
                <td>
                    @if (u.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Desactivado</span>
                    }
                </td>
                <td>
                    @if (u.NombreUsuario != "admin")
                    {
                        <form method="post" asp-page-handler="CambiarActivo" asp-route-id="@u.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                @(u.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>