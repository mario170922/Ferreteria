@page
@model EtiquetasModel
@using Ferreteria.Pages.Pedidos
@using Ferreteria.Services
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Etiquetas - @Negocio.Nombre(User.NegocioActual())</title>
    <partial name="_Estilos" />
    <style>
        .et-fila { display: flex; align-items: center; gap: .75rem; padding: .5rem .9rem; border-bottom: 1px solid var(--fer-borde); }
        .et-fila:last-child { border-bottom: 0; }
        .et-fila input[type=number] { width: 90px; }
        .et-nombre { flex: 1; min-width: 0; }

        /* Hoja de etiquetas: carta, 3 columnas, cada etiqueta de unos 6,5 x 3 cm */
        .et-hoja { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2mm; background: #fff; padding: 4mm; border-radius: 8px; }
        .et-etiqueta {
            border: 1px dashed #bbb; padding: 2mm 3mm; color: #000; background: #fff; height: 30mm;
            display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; break-inside: avoid;
            font-family: "Barlow", Arial, sans-serif;
        }
        .et-etiqueta .n { font-weight: 700; font-size: 9pt; line-height: 1.1; max-height: 2.2em; overflow: hidden; }
        .et-etiqueta .p { font-weight: 800; font-size: 11pt; }
        .et-etiqueta svg { width: 100%; height: 11mm; display: block; }
        .et-etiqueta .c { font-size: 8pt; text-align: center; letter-spacing: .08em; }

        @@media print {
            @@page { size: letter portrait; margin: 8mm; }
            body { background: #fff !important; }
            .no-imprimir, .fer-nav { display: none !important; }
            main.container { max-width: 100% !important; padding: 0 !important; }
            .et-hoja { padding: 0; }
            .et-etiqueta { border-color: #ddd; }
        }
    </style>
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>
<partial name="_Barra" />

<main id="contenido" class="container py-4">

    @if (Model.Imprimir)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 no-imprimir">
            <h1 class="h2 mb-0">@Model.Hoja.Count etiquetas listas</h1>
            <div class="d-flex gap-2">
                <a class="btn btn-fer-outline" href="javascript:history.back()"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Volver</a>
                <button type="button" class="btn btn-fer" onclick="window.print()"><i class="bi bi-printer me-2" aria-hidden="true"></i>Imprimir</button>
            </div>
        </div>
        <div class="et-hoja">
            @foreach (var p in Model.Hoja)
            {
                <div class="et-etiqueta">
                    <div class="d-flex justify-content-between gap-2">
                        <span class="n">@p.Nombre@(string.IsNullOrWhiteSpace(p.Medida) ? "" : " · " + p.Medida)</span>
                        @if (Model.ConPrecio) { <span class="p">@ListaModel.Moneda(p.PrecioVenta)@(p.PrecioPor == 100 ? " x100" : "")</span> }
                    </div>
                    @Html.Raw(CodigoBarrasSvg.Dibujar(p.CodigoBarras))
                    <div class="c">@p.CodigoBarras</div>
                </div>
            }
        </div>
    }
    else
    {
        <h1 class="h2 mb-1">Etiquetas con código de barras</h1>
        <p class="text-secondary mb-3">Escribe cuántas etiquetas quieres de cada producto y presiona <strong>Ver etiquetas</strong>.
            Salen 3 por fila en hoja carta, para recortar o para papel de etiquetas adhesivas.</p>

        <form method="get">
            <input type="hidden" name="imprimir" value="1" />
            <div class="fer-card p-3 mb-3 d-flex flex-wrap gap-3 align-items-center">
                <input type="search" id="filtro" class="form-control" style="max-width: 320px" placeholder="Filtrar productos..." aria-label="Filtrar productos" autocomplete="off" />
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="precio" value="1" id="precio" checked />
                    <label class="form-check-label" for="precio">Mostrar el precio de venta</label>
                </div>
                <button type="button" class="btn btn-fer-outline btn-sm" id="todos-stock">Una por cada unidad en stock</button>
                <button type="submit" class="btn btn-fer ms-auto"><i class="bi bi-upc-scan me-2" aria-hidden="true"></i>Ver etiquetas</button>
            </div>

            <div class="fer-card overflow-hidden">
                @foreach (var p in Model.Productos)
                {
                    <div class="et-fila" data-texto="@($"{p.Nombre} {p.Medida} {p.Codigo} {p.CodigoBarras}".ToLowerInvariant())">
                        <div class="et-nombre">
                            <div class="fw-semibold text-truncate">@p.Nombre@(string.IsNullOrWhiteSpace(p.Medida) ? "" : " · " + p.Medida)</div>
                            <div class="small text-secondary"><i class="bi bi-upc" aria-hidden="true"></i> @p.CodigoBarras · Stock @p.Stock</div>
                        </div>
                        <label class="visually-hidden" for="c_@p.Id">Etiquetas de @p.Nombre</label>
                        <input id="c_@p.Id" name="c_@p.Id" type="number" min="0" max="200" step="1" inputmode="numeric"
                               class="form-control" placeholder="0" data-stock="@p.Stock" />
                    </div>
                }
            </div>
        </form>
    }
</main>

<script>
    (function () {
        var filtro = document.getElementById('filtro');
        if (filtro) filtro.addEventListener('input', function () {
            var t = filtro.value.trim().toLowerCase();
            document.querySelectorAll('.et-fila').forEach(function (f) { f.hidden = t && f.dataset.texto.indexOf(t) < 0; });
        });
        var todos = document.getElementById('todos-stock');
        if (todos) todos.addEventListener('click', function () {
            document.querySelectorAll('.et-fila:not([hidden]) input[data-stock]').forEach(function (i) {
                var s = parseInt(i.dataset.stock, 10) || 0;
                i.value = s > 0 ? Math.min(s, 200) : '';
            });
        });
        // Al enviar, no se mandan los campos vacíos (la dirección queda corta)
        var form = document.querySelector('form[method=get]');
        if (form) form.addEventListener('submit', function () {
            form.querySelectorAll('input[type=number]').forEach(function (i) { if (!i.value || i.value === '0') i.disabled = true; });
        });
    })();
</script>
</body>
</html>
