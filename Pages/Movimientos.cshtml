@page "{id:int}"
@model MovimientosModel
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Movimientos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { font-size: 1.1rem; }
        .form-control, .form-select, .btn { font-size: 1.1rem; min-height: 3rem; }
    </style>
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="/Productos">Ferretería</a>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-light btn-sm" href="/Productos">Inventario</a>
        @if (User.IsInRole("admin"))
        {
            <a class="btn btn-outline-light btn-sm" href="/Ajustar/@Model.Id">Ajustar stock</a>
        }
    </div>
</nav>

<div class="container py-3" style="max-width: 800px;">
    <h1 class="h3 mb-1">Movimientos</h1>
    <p class="mb-3">
        <strong>@Model.Nombre</strong> @Model.Medida<br />
        Stock actual: <strong>@Model.Stock</strong>
    </p>

    @if (Model.Mensaje != null) { <div class="alert alert-success">@Model.Mensaje</div> }
    @if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }

    <form method="post" class="bg-white rounded shadow-sm p-3 mb-4">
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label fw-semibold" for="Tipo">Tipo</label>
                <select asp-for="Tipo" class="form-select">
                    <option value="entrada">Entrada (compra)</option>
                    <option value="salida">Salida</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" for="Cantidad">Cantidad</label>
                <input asp-for="Cantidad" type="number" min="1" class="form-control" />
            </div>
            <div class="col-md-5">
                <label class="form-label fw-semibold" for="Motivo">Motivo</label>
                <input asp-for="Motivo" class="form-control" placeholder="Ej: compra a proveedor" />
            </div>
        </div>
        <button type="submit" class="btn btn-success w-100 mt-3">Registrar</button>
    </form>

    @if (User.IsInRole("admin"))
    {
        <h2 class="h5">Últimos movimientos</h2>
        @if (Model.Historial.Count == 0)
        {
            <div class="alert alert-secondary">Este producto no tiene movimientos.</div>
        }
        else
        {
            <div class="table-responsive bg-white rounded shadow-sm">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th class="text-end">Cantidad</th>
                            <th>Motivo</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var m in Model.Historial)
                    {
                        <tr>
                            <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (m.Cantidad >= 0) { <span class="badge bg-success">Entrada</span> }
                                else { <span class="badge bg-danger">Salida</span> }
                            </td>
                            <td class="text-end">@Math.Abs(m.Cantidad)</td>
                            <td>@m.Motivo</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
</body>
</html>