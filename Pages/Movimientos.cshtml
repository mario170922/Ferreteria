@page "{id:int}"
@model MovimientosModel
@using System.Globalization
@{
    Layout = null;
    var stockBajo = Model.Stock <= 0;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Movimientos - @Negocio.Nombre(User.NegocioActual())</title>
    <partial name="_Estilos" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<partial name="_Barra" />

<main id="contenido" class="container py-4">

    <nav aria-label="Ruta de navegación" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Productos">Inventario</a></li>
            <li class="breadcrumb-item active" aria-current="page">Movimientos</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-success" role="status">@Model.Mensaje</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">@Model.Nombre</h1>
            <p class="text-secondary mb-0">Medida: @(string.IsNullOrWhiteSpace(Model.Medida) ? "—" : Model.Medida)</p>
        </div>
        @if (User.IsInRole("admin"))
        {
            <a class="btn btn-fer-outline" href="/Ajustar/@Model.Id">
                <i class="bi bi-sliders me-2" aria-hidden="true"></i>Ajustar stock
            </a>
        }
    </header>

    <div class="row g-4">

        <section class="col-12 col-lg-5" aria-labelledby="titulo-registro">
            <div class="fer-card h-100">
                <div class="fer-card-cuerpo">

                    <div class="fer-cifra mb-4 @(stockBajo ? "fer-cifra-alerta" : "")">
                        <div class="fer-cifra-etiqueta">Stock actual</div>
                        <div class="fer-cifra-valor">@Model.Stock.ToString("N0", CultureInfo.InvariantCulture)</div>
                    </div>

                    <h2 id="titulo-registro" class="h5 mb-3">Registrar movimiento</h2>

                    <form method="post">
                        <fieldset class="mb-4">
                            <legend class="form-label fw-semibold fs-6">¿Qué pasó con el producto?</legend>
                            <div class="d-grid gap-2 d-sm-flex">
                                <input type="radio" class="btn-check" name="Tipo" id="tipo-entrada"
                                       value="entrada" autocomplete="off" checked="@(Model.Tipo != "salida")" />
                                <label class="btn btn-outline-success flex-fill" for="tipo-entrada">
                                    <i class="bi bi-box-arrow-in-down me-2" aria-hidden="true"></i>Entrada
                                </label>

                                <input type="radio" class="btn-check" name="Tipo" id="tipo-salida"
                                       value="salida" autocomplete="off" checked="@(Model.Tipo == "salida")" />
                                <label class="btn btn-outline-danger flex-fill" for="tipo-salida">
                                    <i class="bi bi-box-arrow-up me-2" aria-hidden="true"></i>Salida
                                </label>
                            </div>
                        </fieldset>

                        <div class="mb-3">
                            <label for="cantidad" class="form-label fw-semibold">
                                Cantidad <span class="text-danger" aria-hidden="true">*</span>
                            </label>
                            <input id="cantidad" name="Cantidad" type="number"
                                   class="form-control form-control-lg"
                                   min="1" max="1000000" step="1" required
                                   value="@(Model.Cantidad > 0 ? Model.Cantidad.ToString(CultureInfo.InvariantCulture) : "")" />
                        </div>

                        <div class="mb-4">
                            <label for="motivo" class="form-label fw-semibold">Motivo (opcional)</label>
                            <input id="motivo" name="Motivo" type="text"
                                   class="form-control form-control-lg"
                                   maxlength="200" autocomplete="off"
                                   value="@Model.Motivo"
                                   placeholder="Ej.: compra a proveedor, daño, conteo" />
                            <div class="form-text">Si lo dejas vacío, se guarda "Entrada manual" o "Salida manual".</div>
                        </div>

                        <button type="submit" class="btn btn-fer btn-lg w-100">
                            <i class="bi bi-check2-circle me-2" aria-hidden="true"></i>Registrar movimiento
                        </button>
                    </form>

                </div>
            </div>
        </section>

        <section class="col-12 col-lg-7" aria-labelledby="titulo-historial">
            @if (User.IsInRole("admin"))
            {
                <div class="fer-card overflow-hidden h-100">
                    <div class="fer-card-cuerpo pb-2">
                        <h2 id="titulo-historial" class="h5 mb-0">Últimos movimientos</h2>
                    </div>

                    @if (Model.Historial.Count == 0)
                    {
                        <div class="fer-vacio">
                            <i class="bi bi-clock-history" aria-hidden="true"></i>
                            <p class="mt-3 mb-0">Este producto todavía no tiene movimientos.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table fer-tabla mb-0">
                                <caption class="visually-hidden">Últimos 50 movimientos del producto</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Fecha</th>
                                        <th scope="col">Tipo</th>
                                        <th scope="col" class="text-end">Cantidad</th>
                                        <th scope="col">Motivo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in Model.Historial)
                                    {
                                        <tr>
                                            <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                                            <td>
                                                @if (m.Cantidad >= 0)
                                                {
                                                    <span class="estado etiqueta-entrada">Entrada</span>
                                                }
                                                else
                                                {
                                                    <span class="estado etiqueta-salida">Salida</span>
                                                }
                                            </td>
                                            <td class="text-end">@Math.Abs(m.Cantidad).ToString("N0", CultureInfo.InvariantCulture)</td>
                                            <td>@m.Motivo</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="fer-card h-100">
                    <div class="fer-card-cuerpo">
                        <h2 id="titulo-historial" class="h5 mb-2">Historial</h2>
                        <p class="text-secondary mb-0">El historial de movimientos lo ve solo el administrador.</p>
                    </div>
                </div>
            }
        </section>

    </div>

</main>

</body>
</html>