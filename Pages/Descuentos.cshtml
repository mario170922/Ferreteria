@page
@model DescuentosModel
@using System.Globalization
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Descuentos - Ferretería</title>
    <partial name="_Estilos" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<partial name="_Barra" />

<main id="contenido" class="container py-4">

    <header class="mb-4">
        <h1 class="h2 mb-1">Descuentos por vendedor</h1>
        <p class="text-secondary mb-0">
            El porcentaje se aplica al total de cada pedido nuevo. Los pedidos ya guardados no cambian.
        </p>
    </header>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-success" role="status">@Model.Mensaje</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    <form method="post">
        <div class="fer-card overflow-hidden">
            <div class="table-responsive">
                <table class="table fer-tabla mb-0">
                    <caption class="visually-hidden">Descuento asignado a cada vendedor</caption>
                    <thead>
                        <tr>
                            <th scope="col">Vendedor</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end">Descuento (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Filas.Count; i++)
                        {
                            var f = Model.Filas[i];
                            <tr>
                                <td>
                                    <strong>@f.NombreUsuario</strong>
                                    <input type="hidden" name="Filas[@i].Id" value="@f.Id" />
                                    <input type="hidden" name="Filas[@i].NombreUsuario" value="@f.NombreUsuario" />
                                    <input type="hidden" name="Filas[@i].Activo" value="@f.Activo" />
                                </td>
                                <td>
                                    <span class="estado @(f.Activo ? "estado-entregado" : "estado-cancelado")">
                                        @(f.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <label class="visually-hidden" for="pct-@i">Descuento de @f.NombreUsuario en porcentaje</label>
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <input id="pct-@i"
                                               type="number"
                                               class="form-control text-end"
                                               style="max-width: 120px;"
                                               name="Filas[@i].DescuentoPct"
                                               value="@f.DescuentoPct.ToString(CultureInfo.InvariantCulture)"
                                               min="0" max="100" step="1" />
                                        <span aria-hidden="true">%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3 mt-4">
            <button type="submit" class="btn btn-fer btn-lg">
                <i class="bi bi-check2 me-2" aria-hidden="true"></i>Guardar descuentos
            </button>
            <a href="/" class="btn btn-fer-outline btn-lg">Volver al inicio</a>
        </div>
    </form>

</main>

</body>
</html>