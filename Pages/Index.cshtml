@page
@model IndexModel
@{
    Layout = null;
    var d = Model.Datos;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inicio - Ferretería</title>
    <partial name="_Estilos" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<partial name="_Barra" />

<main id="contenido" class="container py-4 py-md-5">

    <section class="fer-portada mb-4" aria-labelledby="saludo">
        <img src="/img/logo-casita.png" alt="" class="fer-portada-logo" />
        <div class="position-relative">
            <span class="fer-fecha"><i class="bi bi-calendar3" aria-hidden="true"></i>@Model.Fecha</span>
            <h1 id="saludo" class="fer-saludo">Hola, <span>@Model.NombreUsuario</span></h1>
            <p class="text-secondary fs-5 mb-4">¿Qué quieres hacer hoy?</p>
            <div class="d-flex flex-wrap gap-2">
                @if (User.IsInRole("cajero"))
                {
                    @* El cajero vende en mostrador y maneja la caja *@
                    <a class="btn btn-fer btn-lg" href="/Pedidos/Nuevo?mostrador=true">
                        <i class="bi bi-shop me-2" aria-hidden="true"></i>Venta de mostrador
                    </a>
                    <a class="btn btn-fer-outline btn-lg" href="/Caja">
                        <i class="bi bi-cash-stack me-2" aria-hidden="true"></i>Caja
                    </a>
                }
                else
                {
                    <a class="btn btn-fer btn-lg" href="/Pedidos/Nuevo">
                        <i class="bi bi-cart-plus me-2" aria-hidden="true"></i>Nuevo pedido
                    </a>
                }
                <a class="btn btn-fer-outline btn-lg" href="/Productos">
                    <i class="bi bi-search me-2" aria-hidden="true"></i>Buscar producto
                </a>
            </div>
        </div>
    </section>

    <h2 class="visually-hidden">Resumen de hoy</h2>
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <a class="fer-card fer-dato h-100" href="/Pedidos/Lista">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                <span>
                    <span class="fer-dato-valor d-block">@d.Pendientes</span>
                    <span class="fer-dato-etiqueta">Pedidos pendientes</span>
                </span>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a class="fer-card fer-dato ok h-100" href="/Pedidos/Lista">
                <i class="bi bi-bag-check" aria-hidden="true"></i>
                <span>
                    <span class="fer-dato-valor d-block">@d.PedidosHoy</span>
                    <span class="fer-dato-etiqueta">Pedidos de hoy</span>
                </span>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a class="fer-card fer-dato @(d.StockBajo > 0 ? "alerta" : "ok") h-100" href="/Productos?Bajo=true">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span>
                    <span class="fer-dato-valor d-block">@d.StockBajo</span>
                    <span class="fer-dato-etiqueta">Productos por agotarse</span>
                </span>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a class="fer-card fer-dato h-100" href="/Clientes">
                <i class="bi bi-people" aria-hidden="true"></i>
                <span>
                    <span class="fer-dato-valor d-block">@d.Clientes</span>
                    <span class="fer-dato-etiqueta">Clientes</span>
                </span>
            </a>
        </div>
    </div>

    <partial name="_GraficasInicio" model="Model" />

    <h2 class="h4 mb-3">Accesos</h2>
    <div class="row g-4">

        <div class="col-12 col-md-6 col-lg-4">
            <a class="fer-card fer-acceso" href="@(User.IsInRole("cajero") ? "/Pedidos/Nuevo?mostrador=true" : "/Pedidos/Nuevo")">
                <span class="fer-icono"><i class="bi bi-cart-plus" aria-hidden="true"></i></span>
                <h2 class="mt-3 mb-1">@(User.IsInRole("cajero") ? "Venta de mostrador" : "Nuevo pedido")</h2>
                <p class="fer-descripcion">@(User.IsInRole("cajero") ? "El cliente compra y paga en la tienda." : "Registrar la venta a un cliente.")</p>
                <span class="fer-ir">Empezar <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a class="fer-card fer-acceso" href="/Pedidos/Lista">
                <span class="fer-icono"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                <h2 class="mt-3 mb-1">Pedidos</h2>
                <p class="fer-descripcion">Ver los pedidos de los últimos 3 meses.</p>
                <span class="fer-ir">Ver pedidos <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a class="fer-card fer-acceso" href="/Productos">
                <span class="fer-icono"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                <h2 class="mt-3 mb-1">Inventario</h2>
                <p class="fer-descripcion">Consultar productos, precios y existencias.</p>
                <span class="fer-ir">Ver inventario <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a class="fer-card fer-acceso" href="/Clientes">
                <span class="fer-icono"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span>
                <h2 class="mt-3 mb-1">Clientes</h2>
                <p class="fer-descripcion">Buscar clientes y corregir sus datos.</p>
                <span class="fer-ir">Ver clientes <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>

        @if (Model.EsAdmin)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <a class="fer-card fer-acceso" href="/Resumen">
                    <span class="fer-icono"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span>
                    <h2 class="mt-3 mb-1">Resumen</h2>
                    <p class="fer-descripcion">Ingresos, egresos y lo más y menos vendido por día, semana, mes, semestre y año.</p>
                    <span class="fer-ir">Ver resumen <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </a>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <a class="fer-card fer-acceso" href="/Categorias">
                    <span class="fer-icono"><i class="bi bi-tags" aria-hidden="true"></i></span>
                    <h2 class="mt-3 mb-1">Categorías</h2>
                    <p class="fer-descripcion">Organizar productos en categorías y subcategorías.</p>
                    <span class="fer-ir">Organizar <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </a>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <a class="fer-card fer-acceso" href="/Usuarios">
                    <span class="fer-icono"><i class="bi bi-person-gear" aria-hidden="true"></i></span>
                    <h2 class="mt-3 mb-1">Usuarios</h2>
                    <p class="fer-descripcion">Crear vendedores y activar o desactivar cuentas.</p>
                    <span class="fer-ir">Administrar <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </a>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <a class="fer-card fer-acceso" href="/Descuentos">
                    <span class="fer-icono"><i class="bi bi-percent" aria-hidden="true"></i></span>
                    <h2 class="mt-3 mb-1">Descuentos</h2>
                    <p class="fer-descripcion">Definir el descuento de cada vendedor.</p>
                    <span class="fer-ir">Configurar <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </a>
            </div>
        }

    </div>
</main>

</body>
</html>
