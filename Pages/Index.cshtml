@page
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inicio - Ferretería</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/ferreteria.css" />
</head>
<body>

<a href="#contenido" class="visually-hidden-focusable btn btn-fer m-2">Ir al contenido</a>

<nav class="fer-nav py-3" aria-label="Navegación principal">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
        <a class="fer-marca" href="/">Ferretería · Inventario y pedidos</a>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light" href="/Productos">Inventario</a>
            <a class="btn btn-light" href="/Pedidos/Lista">Pedidos</a>
            @if (Model.EsAdmin)
            {
                <a class="btn btn-light" href="/Usuarios">Usuarios</a>
                <a class="btn btn-light" href="/Descuentos">Descuentos</a>
            }
            <a class="btn btn-outline-light" href="/Salir">Salir</a>
        </div>
    </div>
</nav>

<main id="contenido" class="container py-4 py-md-5">

    <header class="mb-4">
        <h1 class="h2 mb-1">Hola, @Model.NombreUsuario</h1>
        <p class="text-secondary mb-0">¿Qué quieres hacer hoy?</p>
    </header>

    <div class="row g-4">

        <div class="col-12 col-md-6 col-lg-4">
            <a class="fer-card fer-acceso" href="/Pedidos/Nuevo">
                <i class="bi bi-cart-plus fer-icono" aria-hidden="true"></i>
                <h2 class="h5 mt-3">Nuevo pedido</h2>
                <p class="fer-descripcion">Registrar la venta a un cliente.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a class="fer-card fer-acceso" href="/Pedidos/Lista">
                <i class="bi bi-receipt fer-icono" aria-hidden="true"></i>
                <h2 class="h5 mt-3">Pedidos</h2>
                <p class="fer-descripcion">Ver los pedidos de los últimos 3 meses.</p>
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <a class="fer-card fer-acceso" href="/Productos">
                <i class="bi bi-box-seam fer-icono" aria-hidden="true"></i>
                <h2 class="h5 mt-3">Inventario</h2>
                <p class="fer-descripcion">Consultar productos, precios y existencias.</p>
            </a>
        </div>

        @if (Model.EsAdmin)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <a class="fer-card fer-acceso" href="/Usuarios">
                    <i class="bi bi-people fer-icono" aria-hidden="true"></i>
                    <h2 class="h5 mt-3">Usuarios</h2>
                    <p class="fer-descripcion">Crear vendedores y activar o desactivar cuentas.</p>
                </a>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <a class="fer-card fer-acceso" href="/Descuentos">
                    <i class="bi bi-percent fer-icono" aria-hidden="true"></i>
                    <h2 class="h5 mt-3">Descuentos</h2>
                    <p class="fer-descripcion">Definir el descuento de cada vendedor.</p>
                </a>
            </div>
        }

    </div>
</main>

</body>
</html>